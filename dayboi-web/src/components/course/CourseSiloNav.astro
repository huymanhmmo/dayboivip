---
export interface Props {
  currentSlug: string;
  lang?: 'vi' | 'en';
}

const { currentSlug, lang = 'vi' } = Astro.props;
const isEn = lang === 'en';

const coursesVi = [
  {
    slug: '1-kem-1',
    name: 'Khóa Học Bơi 1 Kèm 1',
    format: '1 HLV kèm 1 học viên',
    desc: 'Phương pháp kèm sát từng động tác, cam kết biết bơi nhanh và vững vàng.',
    href: '/khoa-hoc-boi/1-kem-1/'
  },
  {
    slug: 'tre-em',
    name: 'Khóa Học Bơi Trẻ Em',
    format: 'Trẻ từ 4 - 15 tuổi',
    desc: 'Giáo trình chuẩn sư phạm lồng ghép kỹ năng sinh tồn, phản xạ tự cứu.',
    href: '/khoa-hoc-boi/tre-em/'
  },
  {
    slug: 'nguoi-lon',
    name: 'Khóa Học Bơi Người Lớn',
    format: 'Lịch học linh hoạt',
    desc: 'Lộ trình tối ưu theo thể lực, giúp làm chủ kỹ thuật và rèn luyện thể chất.',
    href: '/khoa-hoc-boi/nguoi-lon/'
  },
  {
    slug: 'nguoi-so-nuoc',
    name: 'Khóa Bơi Cho Người Sợ Nước',
    format: 'Tâm lý học thể thao',
    desc: 'Giải tỏa nỗi sợ nước sâu từ từ trong bể nông có bục đứng, HLV sát bên 100%.',
    href: '/khoa-hoc-boi/nguoi-so-nuoc/'
  },
  {
    slug: 'nguoi-cao-tuoi',
    name: 'Bơi Dưỡng Sinh Người Cao Tuổi',
    format: 'Bảo vệ xương khớp',
    desc: 'Bài tập dưới nước giảm áp lực khớp gối, tăng tuần hoàn và cải thiện giấc ngủ.',
    href: '/khoa-hoc-boi/nguoi-cao-tuoi/'
  },
  {
    slug: 'nhom',
    name: 'Khóa Bơi Nhóm Nhỏ (2 - 4 người)',
    format: 'Gia đình & Bạn bè',
    desc: 'Tập luyện vui vẻ cùng người thân, tiết kiệm học phí mà vẫn đảm bảo chất lượng.',
    href: '/khoa-hoc-boi/nhom/'
  },
  {
    slug: 'doanh-nghiep',
    name: 'Đào Tạo Doanh Nghiệp & Đoàn Thể',
    format: 'Quy mô từ 10 học viên',
    desc: 'Chương trình teambuilding thể thao nước và phổ cập bơi an toàn cho cán bộ.',
    href: '/khoa-hoc-boi/doanh-nghiep/'
  }
];

const coursesEn = [
  {
    slug: '1-on-1',
    name: 'Private 1-on-1 Swimming',
    format: 'Dedicated Coach',
    desc: 'Personalized pacing, continuous correction, guaranteed stroke competence.',
    href: '/en/courses/1-on-1/'
  },
  {
    slug: 'kids',
    name: 'Kids Swimming Lessons',
    format: 'Ages 4 - 15',
    desc: 'Pedagogical curriculum blending stroke mechanics with water safety reflexes.',
    href: '/en/courses/kids/'
  },
  {
    slug: 'adults',
    name: 'Adult Swimming Courses',
    format: 'Flexible Schedule',
    desc: 'Structured progression customized for adult fitness, stamina, and efficiency.',
    href: '/en/courses/adults/'
  },
  {
    slug: 'fear-of-water',
    name: 'Fear of Water Program',
    format: 'Gentle Acclimation',
    desc: 'Overcome deep water anxiety safely in shallow lanes with 100% coach presence.',
    href: '/en/courses/fear-of-water/'
  },
  {
    slug: 'seniors',
    name: 'Senior Hydrotherapy Swimming',
    format: 'Joint-Friendly',
    desc: 'Low-impact aquatic movement enhancing joint mobility and cardiovascular ease.',
    href: '/en/courses/seniors/'
  },
  {
    slug: 'group',
    name: 'Small Group Lessons (2-4 pax)',
    format: 'Family & Friends',
    desc: 'Fun and motivating group sessions maintaining high coach attention.',
    href: '/en/courses/group/'
  },
  {
    slug: 'corporate',
    name: 'Corporate & Group Programs',
    format: '10+ Participants',
    desc: 'Structured aquatic safety workshops and fitness training for organizations.',
    href: '/en/courses/corporate/'
  }
];

const courses = isEn ? coursesEn : coursesVi;
---

<section class="cl-section course-silo-nav" aria-labelledby="silo-courses-title">
  <div class="cl-section__container">
    <div class="cl-section-title">
      <span class="cl-section-title__badge">
        {isEn ? 'Course Directory & Silo' : 'Hệ thống chương trình'}
      </span>
      <h2 class="cl-section-title__heading" id="silo-courses-title">
        {isEn ? 'Explore Other Swimming Courses' : 'Khám Phá Các Khóa Học Bơi Khác'}
      </h2>
      <p class="cl-section-title__sub">
        {isEn 
          ? 'Swim For Life offers tailored programs for all ages, skill levels, and learning goals.' 
          : 'Swim For Life thiết kế các lộ trình chuyên biệt phù hợp cho từng độ tuổi, thể trạng và mục tiêu bơi lội.'}
      </p>
      <span class="cl-section-title__decoration"></span>
    </div>

    <!-- Sibling Spoke Links -->
    <div class="course-silo-grid">
      {courses.map((item) => {
        const isCurrent = item.slug === currentSlug;
        return (
          <article class:list={['course-silo-card', { 'is-current': isCurrent }]}>
            <div class="course-silo-card__meta">
              <span class="course-silo-card__format">{item.format}</span>
              {isCurrent && <span class="course-silo-card__tag">{isEn ? 'Viewing' : 'Đang xem'}</span>}
            </div>
            <h3 class="course-silo-card__title">
              {isCurrent ? (
                <span>{item.name}</span>
              ) : (
                <a href={item.href}>{item.name}</a>
              )}
            </h3>
            <p class="course-silo-card__desc">{item.desc}</p>
            <div class="course-silo-card__action">
              {isCurrent ? (
                <span class="course-silo-card__status">✓ {isEn ? 'Current Program' : 'Khóa học hiện tại'}</span>
              ) : (
                <a href={item.href} class="course-silo-card__link">
                  <span>{isEn ? 'View Course Details' : 'Xem chi tiết khóa học'}</span>
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"/></svg>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <!-- Upward Hub & Cross-Silo Recommendations -->
    <div class="course-silo-cross">
      <div class="course-silo-cross__hub">
        <div>
          <small>{isEn ? 'Course Hub' : 'Trang chủ chương trình'}</small>
          <h4>{isEn ? 'Compare All Swim For Life Programs' : 'Xem Bảng So Sánh Toàn Bộ Khóa Học'}</h4>
          <p>{isEn ? 'Overview of learning duration, trial sessions, and pricing tiers.' : 'Xem tổng hợp học phí, thời lượng buổi học và chính sách cam kết biết bơi.'}</p>
        </div>
        <a href={isEn ? '/en/courses/' : '/khoa-hoc-boi/'} class="btn-silo-hub">
          <span>{isEn ? 'All Courses Directory' : 'Mở danh mục khóa học'}</span>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"/></svg>
        </a>
      </div>

      <div class="course-silo-cross__bridges">
        <a href={isEn ? '/en/swimming-techniques/' : '/ky-thuat-boi/'} class="silo-bridge-card">
          <div class="silo-bridge-card__icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="5" r="2"/><path d="M6 14l3.5-3.5L14 12l4-4M3 9l3 2 3-1.5M2 19c3.5-1.5 7-1.5 10.5 0 3.5-1.5 7-1.5 10.5 0"/></svg>
          </div>
          <div class="silo-bridge-card__body">
            <strong>{isEn ? '5 Core Swimming Techniques' : '5 Kỹ Thuật Bơi Tiêu Chuẩn'}</strong>
            <span>{isEn ? 'Explore breaststroke, front crawl, backstroke, and butterfly guides' : 'Hướng dẫn tự học bơi ếch, bơi sải, bơi ngửa, bơi bướm và đứng nước'}</span>
          </div>
          <span class="silo-bridge-arrow">↗</span>
        </a>

        <a href={isEn ? '/en/swimming-locations/' : '/hoc-boi-o-dau/'} class="silo-bridge-card">
          <div class="silo-bridge-card__icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
          </div>
          <div class="silo-bridge-card__body">
            <strong>{isEn ? 'Swimming Pool Directory' : 'Danh Bạ Bể Bơi Gần Bạn'}</strong>
            <span>{isEn ? 'Find verified pool addresses and contact details in 34 provinces' : 'Tra cứu địa chỉ, vé vào bể và lớp học bơi tại Hà Nội, TP.HCM & toàn quốc'}</span>
          </div>
          <span class="silo-bridge-arrow">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .course-silo-nav {
    background: #f8fafc;
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) 0;
  }

  .course-silo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .course-silo-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
  }

  .course-silo-card:hover {
    border-color: var(--theme-secondary, #00BCD4);
    box-shadow: 0 8px 24px rgba(10, 77, 140, 0.08);
    transform: translateY(-2px);
  }

  .course-silo-card.is-current {
    border-color: var(--theme-primary, #0A4D8C);
    background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);
    box-shadow: 0 4px 12px rgba(10, 77, 140, 0.06);
  }

  .course-silo-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .course-silo-card__format {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--theme-primary, #0A4D8C);
  }

  .course-silo-card__tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 9999px;
    background: var(--theme-primary, #0A4D8C);
    color: #ffffff;
  }

  .course-silo-card__title {
    font-size: 1.05rem;
    line-height: 1.35;
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .course-silo-card__title a {
    color: var(--color-dark, #0f172a);
    text-decoration: none;
    transition: color 0.2s;
  }

  .course-silo-card__title a:hover {
    color: var(--theme-primary, #0A4D8C);
  }

  .course-silo-card__desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-text-secondary, #64748b);
    margin: 0 0 var(--space-4);
    flex-grow: 1;
  }

  .course-silo-card__action {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid #f1f5f9;
  }

  .course-silo-card__status {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--theme-primary, #0A4D8C);
  }

  .course-silo-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--theme-primary, #0A4D8C);
    text-decoration: none;
    transition: gap 0.2s;
  }

  .course-silo-card__link:hover {
    gap: 8px;
    color: var(--theme-secondary, #00BCD4);
  }

  .course-silo-cross {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .course-silo-cross__hub {
    background: linear-gradient(135deg, #052e56 0%, #0A4D8C 100%);
    color: #ffffff;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .course-silo-cross__hub small {
    display: block;
    color: var(--theme-secondary, #00BCD4);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .course-silo-cross__hub h4 {
    font-size: 1.2rem;
    margin: 0 0 6px;
    color: #ffffff;
  }

  .course-silo-cross__hub p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 var(--space-4);
  }

  .btn-silo-hub {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    background: var(--theme-secondary, #00BCD4);
    color: #032b43;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 8px 16px;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-silo-hub:hover {
    background: #ffffff;
    color: var(--theme-primary, #0A4D8C);
    transform: translateY(-1px);
  }

  .course-silo-cross__bridges {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .silo-bridge-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    flex: 1;
  }

  .silo-bridge-card:hover {
    border-color: var(--theme-secondary, #00BCD4);
    box-shadow: 0 6px 18px rgba(10, 77, 140, 0.06);
    transform: translateX(3px);
  }

  .silo-bridge-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #f0f7ff;
    color: var(--theme-primary, #0A4D8C);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .silo-bridge-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .silo-bridge-card__body strong {
    font-size: 0.95rem;
    color: var(--color-dark, #0f172a);
    margin-bottom: 2px;
  }

  .silo-bridge-card__body span {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--color-text-secondary, #64748b);
  }

  .silo-bridge-arrow {
    font-size: 1.1rem;
    color: var(--theme-secondary, #00BCD4);
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .course-silo-cross {
      grid-template-columns: 1fr;
    }
  }
</style>
