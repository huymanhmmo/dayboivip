---
import LocalSiteContactBar from '../locality/LocalSiteContactBar.astro';
export interface Props {phoneHref:string;zaloHref:string;label?:string;}
const {phoneHref,zaloHref,label='Liên hệ học bơi'}=Astro.props;
---
<LocalSiteContactBar primary={{href:phoneHref,label:'Gọi tư vấn',icon:'phone'}} secondary={{href:zaloHref,label:'Tư vấn qua Zalo',icon:'chat',external:true}} label={label} />
