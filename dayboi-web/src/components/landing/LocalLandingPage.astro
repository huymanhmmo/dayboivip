---
import MainLayout from '../../layouts/MainLayout.astro';
import LaiThieuHeader from './LaiThieuHeader.astro';
import SwimmingHero from './SwimmingHero.astro';
import SwimmingAudienceGrid from './SwimmingAudienceGrid.astro';
import PoolFinderSection from './PoolFinderSection.astro';
import FeaturedCoursesSection from './FeaturedCoursesSection.astro';
import SwimmingTechniquesSection from './SwimmingTechniquesSection.astro';
import LearningJourneySection from './LearningJourneySection.astro';
import InstructorSection from './InstructorSection.astro';
import BenefitsSection from './BenefitsSection.astro';
import LocalAreaInfoSection from './LocalAreaInfoSection.astro';
import TestimonialsSection from './TestimonialsSection.astro';
import EnrollmentCTA from './EnrollmentCTA.astro';
import LaiThieuFooter from './LaiThieuFooter.astro';
import type { LocalLandingData } from '../../data/localLandingPages';
import '../../styles/local-swimming-landing.css';
import '../../styles/local-swimming-techniques.css';

export interface Props { data: LocalLandingData; }
const { data } = Astro.props;
const instructorLabel = `${data.instructor.name} – ${data.instructor.qualification}`;
const breadcrumbs = [{name:'Trang chủ',url:'https://dayboi.vip/'},{name:'Học bơi TP.HCM',url:'https://dayboi.vip/hoc-boi-tphcm/'},{name:`Học bơi ${data.name}`,url:data.canonical}];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {'@type':'CollectionPage','@id':`${data.canonical}#page`,name:data.title,description:data.description,url:data.canonical,dateModified:data.updatedAt,mainEntity:{'@id':`${data.canonical}#venues`},about:{'@id':`${data.canonical}#instructor`}},
    {'@type':'ItemList','@id':`${data.canonical}#venues`,numberOfItems:data.pools.length,itemListElement:data.pools.map((pool,index)=>({'@type':'ListItem',position:index+1,item:{'@type':'SportsActivityLocation',name:pool.name,url:pool.detailHref?`https://dayboi.vip${pool.detailHref}`:`${data.canonical}#${pool.id}`,image:pool.image && !pool.imageNote ? `https://dayboi.vip${pool.image}` : undefined,address:{'@type':'PostalAddress',streetAddress:pool.address,addressRegion:'TP.HCM',addressCountry:'VN'},description:pool.detail}}))},
    {'@type':'Person','@id':`${data.canonical}#instructor`,name:data.instructor.name.replace('Thầy ',''),jobTitle:`${data.instructor.qualification} – HLV phụ trách khu vực ${data.name}`,telephone:data.hotline},
    {'@type':'BreadcrumbList',itemListElement:breadcrumbs.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.name,item:item.url}))},
  ],
};
---
<MainLayout title={data.title} description={data.description} canonicalUrl={data.canonical} ogImage={data.heroImage} schema={schema}>
  <div slot="header" class="sfl-landing lt-hub-header"><LaiThieuHeader hotline={data.hotline} phoneHref={data.phoneHref} zaloHref={data.zaloHref} courseBaseHref="/hoc-boi-tphcm/lai-thieu/" /></div>
  <article class="sfl-landing sfl-page">
    <SwimmingHero data={data} />
    <SwimmingAudienceGrid cards={data.audiences} />
    <PoolFinderSection pools={data.pools} name={data.name} phoneHref={data.phoneHref} instructorLabel={instructorLabel} />
    <FeaturedCoursesSection courses={data.courses} />
    <SwimmingTechniquesSection techniques={data.techniques} />
    <LearningJourneySection steps={data.journey} image="/images/landing/lai-thieu/journey.webp" />
    <InstructorSection instructor={data.instructor} />
    <BenefitsSection benefits={data.benefits} />
    <LocalAreaInfoSection local={data.local} name={data.name} />
    <TestimonialsSection testimonials={data.testimonials} areaName={data.name} />
    <EnrollmentCTA name={data.name} hotline={data.hotline} phoneHref={data.phoneHref} instructorLabel={instructorLabel} />
    <nav class="sfl-container sfl-breadcrumb" aria-label="Đường dẫn trang"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><a href="/hoc-boi-tphcm/">Học bơi TP.HCM</a><span aria-hidden="true">/</span><span aria-current="page">{data.name}</span></nav>
  </article>
  <div slot="footer" class="sfl-landing"><LaiThieuFooter hotline={data.hotline} phoneHref={data.phoneHref} zaloHref={data.zaloHref} courseBaseHref="/hoc-boi-tphcm/lai-thieu/" /></div>
</MainLayout>
