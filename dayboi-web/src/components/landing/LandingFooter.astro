---
import Icon from './ui/Icon.astro';
import WaveDivider from './ui/WaveDivider.astro';
export interface Props { name: string; hotline: string; phoneHref: string; zaloHref: string; instructorName: string; }
const { name, hotline, phoneHref, zaloHref, instructorName } = Astro.props;
---
<footer class="sfl-footer"><div class="sfl-container sfl-footer-grid"><div><a class="sfl-brand" href="/"><Icon name="wave" /><span><strong>Swim For Life Việt Nam</strong><small>Học bơi an toàn – Kỹ năng trọn đời</small></span></a><p>Đồng hành cùng trẻ em, người lớn và gia đình tại {name}, TP.HCM trên hành trình học bơi an toàn, đúng kỹ thuật.</p><div class="sfl-footer-social"><a href={zaloHref} target="_blank" rel="noopener noreferrer" aria-label={`Zalo tư vấn khu vực ${name}`}><Icon name="chat" /></a><a href={phoneHref} aria-label="Gọi tư vấn"><Icon name="phone" /></a><a href="/lien-he/" aria-label="Trang liên hệ"><Icon name="headset" /></a></div></div><div><h3>Thông tin liên hệ</h3><ul><li><a href={phoneHref}><Icon name="phone" />{hotline}</a></li><li><a href={zaloHref} target="_blank" rel="noopener noreferrer"><Icon name="chat" />Zalo tư vấn xếp lớp</a></li><li><a href="/"><Icon name="wave" />dayboi.vip</a></li><li><Icon name="pin" /><span>Khu vực {name}, TP.HCM<br/>{instructorName}</span></li></ul></div><div><h3>Hỗ trợ & dịch vụ</h3><ul><li><a href="#dang-ky">Đăng ký khóa học</a></li><li><a href="#lo-trinh">Tư vấn lộ trình</a></li><li><a href="/bang-gia/">Thông tin học phí</a></li><li><a href="/khoa-hoc-boi/1-kem-1/">Học bơi kèm riêng</a></li></ul></div><div><h3>Khám phá thêm</h3><ul><li><a href="/gioi-thieu/">Về chúng tôi</a></li><li><a href="/tin-tuc/">Tin tức</a></li><li><a href="/ky-thuat-boi/">Kiến thức bơi</a></li><li><a href="/hoc-boi-tphcm/">Địa điểm học bơi TP.HCM</a></li></ul></div></div><div class="sfl-container sfl-footer-bottom"><span>© {new Date().getFullYear()} Swim For Life Việt Nam · Công ty CP Your Dreams.</span><span>Ảnh học bơi dùng cho mục đích minh họa.</span></div><WaveDivider class="sfl-footer-wave" /></footer>
<nav class="sfl-mobile-contact" aria-label="Liên hệ nhanh"><a href={phoneHref}><Icon name="phone" />Gọi {hotline}</a><a href={zaloHref} target="_blank" rel="noopener noreferrer"><Icon name="chat" />Nhắn Zalo</a></nav>
