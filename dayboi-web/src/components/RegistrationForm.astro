---
export interface Props {
  id?: string;
  className?: string;
  isFullForm?: boolean;
  defaultCourse?: string;
  flat?: boolean;
  lang?: 'vi' | 'en';
}

const { id = 'enterprise-inquiry-form', className = '', flat = false, lang = 'vi' } = Astro.props;
---

<div class:list={['enterprise-form-card', { 'enterprise-form-card--flat': flat }, className]} id={`${id}-container`}>
  <form class="enterprise-form" id={id} data-lang={lang}>
    <div class="enterprise-form__grid">
      <label>
        <span>{lang === 'vi' ? 'Tên doanh nghiệp / tổ chức *' : 'Organization name *'}</span>
        <input name="organization" type="text" required autocomplete="organization" placeholder={lang === 'vi' ? 'Tên đơn vị của bạn' : 'Your organization'} />
      </label>
      <label>
        <span>{lang === 'vi' ? 'Người phụ trách *' : 'Contact person *'}</span>
        <input name="fullname" type="text" required autocomplete="name" placeholder={lang === 'vi' ? 'Họ và tên' : 'Full name'} />
      </label>
      <label>
        <span>{lang === 'vi' ? 'Email công việc *' : 'Work email *'}</span>
        <input name="email" type="email" required autocomplete="email" placeholder="name@company.com" />
      </label>
      <label>
        <span>{lang === 'vi' ? 'Số điện thoại người phụ trách *' : 'Contact phone *'}</span>
        <input name="phone" type="tel" required autocomplete="tel" placeholder={lang === 'vi' ? 'Số điện thoại của bạn' : 'Your phone number'} />
      </label>
      <label>
        <span>{lang === 'vi' ? 'Quy mô dự kiến *' : 'Expected group size *'}</span>
        <select name="scale" required>
          <option value="">{lang === 'vi' ? 'Chọn quy mô' : 'Select group size'}</option>
          <option value="10-30">10–30</option>
          <option value="31-100">31–100</option>
          <option value="101-300">101–300</option>
          <option value="300+">300+</option>
        </select>
      </label>
      <label>
        <span>{lang === 'vi' ? 'Khu vực triển khai *' : 'Implementation location *'}</span>
        <input name="location" type="text" required placeholder={lang === 'vi' ? 'Tỉnh/thành hoặc nhiều cơ sở' : 'City/province or multiple sites'} />
      </label>
    </div>
    <label>
      <span>{lang === 'vi' ? 'Loại chương trình *' : 'Program type *'}</span>
      <select name="course" required>
        <option value="Đào tạo bơi doanh nghiệp">{lang === 'vi' ? 'Đào tạo bơi cho doanh nghiệp' : 'Corporate swimming program'}</option>
        <option value="Trường học">{lang === 'vi' ? 'Chương trình cho trường học' : 'School program'}</option>
        <option value="Khu dân cư">{lang === 'vi' ? 'Chương trình cho khu dân cư' : 'Residential community program'}</option>
        <option value="Sự kiện an toàn nước">{lang === 'vi' ? 'Sự kiện / chuyên đề an toàn nước' : 'Water-safety event'}</option>
      </select>
    </label>
    <label>
      <span>{lang === 'vi' ? 'Mục tiêu và yêu cầu triển khai' : 'Goals and requirements'}</span>
      <textarea name="message" rows="5" placeholder={lang === 'vi' ? 'Đối tượng học viên, thời gian dự kiến, số cơ sở, yêu cầu báo giá…' : 'Audience, timeline, number of sites, proposal requirements…'}></textarea>
    </label>
    <p class="enterprise-form__policy">{lang === 'vi'
      ? 'Biểu mẫu này chỉ tiếp nhận nhu cầu đào tạo theo đoàn từ 10 người, trường học, doanh nghiệp và khu dân cư.'
      : 'This form is exclusively for organizations, schools, residential communities and groups of 10 or more.'}</p>
    <button type="submit">
      {lang === 'vi' ? 'Gửi yêu cầu đề xuất chương trình' : 'Request a program proposal'}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
    </button>
  </form>

  <div class="enterprise-form__success" hidden>
    <span aria-hidden="true">✓</span>
    <h3>{lang === 'vi' ? 'Đã ghi nhận yêu cầu hợp tác' : 'Your partnership request was received'}</h3>
    <p>{lang === 'vi'
      ? 'Swim For Life sẽ xem xét quy mô và yêu cầu triển khai trước khi phản hồi người phụ trách của đơn vị.'
      : 'Swim For Life will review the scope and requirements before responding to your organization’s contact person.'}</p>
  </div>
</div>

<style>
  .enterprise-form-card { width: 100%; padding: clamp(1.25rem, 4vw, 2.5rem); border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--white); box-shadow: var(--shadow-lg); }
  .enterprise-form-card--flat { padding: 0; border: 0; box-shadow: none; }
  .enterprise-form { display: grid; gap: var(--space-5); }
  .enterprise-form__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .enterprise-form label { display: grid; gap: var(--space-2); color: var(--ink-800); font-size: .78rem; font-weight: 750; letter-spacing: .03em; }
  .enterprise-form input, .enterprise-form select, .enterprise-form textarea { width: 100%; min-height: 50px; padding: .8rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--sand-50); color: var(--ink-900); font: inherit; font-size: .92rem; }
  .enterprise-form textarea { min-height: 130px; resize: vertical; }
  .enterprise-form input:focus, .enterprise-form select:focus, .enterprise-form textarea:focus { border-color: var(--blue-500); outline: 3px solid color-mix(in srgb, var(--blue-400) 20%, transparent); }
  .enterprise-form__policy { margin: 0; padding: var(--space-3) var(--space-4); border-inline-start: 3px solid var(--orange-500); background: var(--orange-50); color: var(--ink-700); font-size: .84rem; line-height: 1.6; }
  .enterprise-form button { min-height: 54px; display: inline-flex; align-items: center; justify-content: center; gap: var(--space-3); padding: 0 var(--space-6); border: 0; border-radius: var(--radius-md); background: var(--orange-500); color: var(--white); font: inherit; font-weight: 800; cursor: pointer; }
  .enterprise-form button:hover { background: var(--orange-600); }
  .enterprise-form button svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 2; }
  .enterprise-form__success { padding: var(--space-8); text-align: center; }
  .enterprise-form__success > span { width: 52px; height: 52px; display: grid; place-items: center; margin: 0 auto var(--space-4); border-radius: 50%; background: var(--blue-100); color: var(--blue-700); font-size: 1.5rem; font-weight: 800; }
  .enterprise-form__success h3 { margin: 0; color: var(--blue-900); }
  .enterprise-form__success p { margin: var(--space-3) auto 0; max-width: 560px; color: var(--ink-600); line-height: 1.7; }
  @media (max-width: 680px) { .enterprise-form__grid { grid-template-columns: 1fr; } }
</style>

<script>
  function initEnterpriseForms() {
    document.querySelectorAll<HTMLFormElement>('.enterprise-form').forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submit) submit.disabled = true;
        const payload = Object.fromEntries(new FormData(form).entries());
        const endpoint = 'https://script.google.com/macros/s/AKfycbwPnFxy2-YUeJjxBbQp78MPHKkX3BKXuLh85acL4zLsz0LR4gHCA7ot0JRh7XNPXlR1-g/exec';
        try {
          await fetch(endpoint, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify({ ...payload, leadType: 'enterprise' }) });
          form.hidden = true;
          const success = form.parentElement?.querySelector<HTMLElement>('.enterprise-form__success');
          if (success) success.hidden = false;
          form.reset();
        } catch (error) {
          console.error('Unable to submit enterprise enquiry', error);
          if (submit) submit.disabled = false;
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', initEnterpriseForms);
  document.addEventListener('astro:page-load', initEnterpriseForms);
  initEnterpriseForms();
</script>
