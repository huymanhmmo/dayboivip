---
export interface Props {
  lang?: 'vi' | 'en';
  compact?: boolean;
}

const { lang = 'vi', compact = false } = Astro.props;
---

<section class:list={['directory-cta', { 'directory-cta--compact': compact }]} aria-labelledby="directory-cta-title">
  <div class="directory-cta__content">
    <span class="directory-cta__eyebrow">{lang === 'vi' ? 'Dành cho người học cá nhân' : 'For individual learners'}</span>
    <h2 id="directory-cta-title">{lang === 'vi' ? 'Tự chọn bể bơi và đơn vị dạy gần bạn' : 'Find a local pool or independent provider'}</h2>
    <p>{lang === 'vi'
      ? 'Swim For Life không tiếp nhận đăng ký học bơi lẻ. Danh bạ địa phương giúp bạn tra cứu bể bơi, câu lạc bộ và giáo viên có thông tin công khai để liên hệ trực tiếp.'
      : 'Swim For Life no longer accepts individual lesson enquiries. Use the local directory to contact publicly listed pools, clubs and independent instructors directly.'}</p>
    <div class="directory-cta__actions">
      <a href={lang === 'vi' ? '/hoc-boi-o-dau/' : '/en/swimming-locations/'} class="directory-cta__primary">
        {lang === 'vi' ? 'Mở danh bạ địa phương' : 'Open local directory'}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
      <a href={lang === 'vi' ? '/khoa-hoc-boi/doanh-nghiep/' : '/en/contact/'} class="directory-cta__secondary">
        {lang === 'vi' ? 'Giải pháp cho tổ chức' : 'Programs for organizations'}
      </a>
    </div>
  </div>
</section>

<style>
  .directory-cta { margin: var(--space-12) auto; padding: var(--space-10); border: 1px solid color-mix(in srgb, var(--blue-500) 22%, transparent); border-radius: var(--radius-xl); background: linear-gradient(135deg, var(--blue-950), var(--blue-800)); color: var(--white); }
  .directory-cta--compact { margin: 0; padding: var(--space-6); }
  .directory-cta__content { max-width: 820px; }
  .directory-cta__eyebrow { display: block; margin-bottom: var(--space-3); color: var(--blue-200); font-size: .74rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .directory-cta h2 { margin: 0; color: var(--white); font-size: clamp(1.65rem, 3.4vw, 3rem); letter-spacing: -.04em; }
  .directory-cta--compact h2 { font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .directory-cta p { max-width: 700px; margin: var(--space-4) 0 0; color: color-mix(in srgb, var(--white) 75%, transparent); line-height: 1.75; }
  .directory-cta__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .directory-cta__actions a { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); padding: 0 var(--space-5); border-radius: var(--radius-md); font-weight: 750; }
  .directory-cta__primary { background: var(--orange-500); color: var(--white); }
  .directory-cta__primary:hover { background: var(--orange-600); color: var(--white); }
  .directory-cta__primary svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 2; }
  .directory-cta__secondary { border: 1px solid color-mix(in srgb, var(--white) 28%, transparent); color: var(--white); }
  .directory-cta__secondary:hover { background: color-mix(in srgb, var(--white) 8%, transparent); color: var(--white); }
  @media (max-width: 640px) {
    .directory-cta { padding: var(--space-7) var(--space-5); }
    .directory-cta__actions { flex-direction: column; }
    .directory-cta__actions a { width: 100%; }
  }
</style>
