---
import SectionHeading from '../landing/ui/SectionHeading.astro';
import type { PoolDetailData } from '../../data/poolDetailTypes';
export interface Props { title: string; intro: string; items: PoolDetailData['guide']; sources: PoolDetailData['sources']; updatedAt: string; }
const {title,intro,items,sources,updatedAt}=Astro.props;
---
<section class="pd-guide" aria-labelledby="guide-heading"><SectionHeading id="guide-heading" title={title} description={intro} icon="route" /><div class="pd-guide-grid">{items.map(item=><details id={item.id}><summary><h3>{item.title}</h3><span aria-hidden="true">+</span></summary><div>{item.paragraphs.map(p=><p>{p}</p>)}{item.bullets&&<ul>{item.bullets.map(b=><li>{b}</li>)}</ul>}</div></details>)}</div><div class="pd-source-note"><strong>Nguồn & cập nhật</strong><span>Biên tập nội dung {updatedAt.split('-').reverse().join('/')}.</span><ul>{sources.map(source=><li>{source.url?<a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>:<span>{source.title}</span>}: {source.note}</li>)}</ul></div></section>
