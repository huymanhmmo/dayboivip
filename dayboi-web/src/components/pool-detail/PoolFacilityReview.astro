---
import SectionHeading from '../landing/ui/SectionHeading.astro';
import Icon from '../landing/ui/Icon.astro';
import type { PoolDetailData, VerificationState } from '../../data/poolDetailTypes';
export interface Props { facilities: PoolDetailData['facilities']; note: string; }
const {facilities,note}=Astro.props;
const labels:Record<VerificationState,string>={verified:'Đã xác minh',unverified:'Cần xác minh',unavailable:'Không có',updating:'Đang cập nhật',documented:'Theo tài liệu'};
---
<section class="pd-facilities pd-panel" aria-labelledby="facility-heading"><SectionHeading id="facility-heading" title="Đánh giá nhanh về địa điểm" icon="shield" /><ul>{facilities.map(f=><li data-status={f.status}><Icon name={f.status==='verified'?'check':f.status==='unavailable'?'close':'search'} /><div><strong>{f.label}</strong><small>{f.note}</small></div><span>{labels[f.status]}</span></li>)}</ul><p class="pd-caption">{note}</p></section>
