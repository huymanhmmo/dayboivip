---
import Icon from '../landing/ui/Icon.astro';
import WaveDivider from '../landing/ui/WaveDivider.astro';
export interface Props { name: string; hotline: string; phoneHref: string; zaloHref: string; }
const {name,hotline,phoneHref,zaloHref}=Astro.props;
---
<section class="pd-enrollment" id="dang-ky" aria-labelledby="enrollment-heading"><WaveDivider /><div class="sfl-container pd-enrollment-inner"><Icon name="swim" /><div><h2 id="enrollment-heading">Đăng ký học bơi tại {name} ngay hôm nay!</h2><p>Tư vấn lộ trình phù hợp, xếp lớp theo trình độ và hỗ trợ chọn lịch học thuận tiện.</p></div><div class="pd-actions"><a href={phoneHref} class="sfl-button sfl-button--light"><Icon name="phone" />{hotline}</a><a href={zaloHref} class="sfl-button sfl-button--orange" target="_blank" rel="noopener noreferrer"><Icon name="chat" />Đăng ký tư vấn</a></div></div></section>
