---
import Icon from '../landing/ui/Icon.astro';
import type {RegionPageData} from '../../data/locality/types';
const {page}=Astro.props as {page:RegionPageData};const en=page.lang==='en';
const steps=en?[['The right place','Check the address, learner access and suitable practice space.'],['The right teacher','Speak to the named instructor about experience, goals and supervision.'],['Clear costs','Confirm tuition separately from admission and any facility charges.'],['A realistic plan','Agree frequency, session length and rescheduling before paying.']]:[['Chọn đúng nơi','Đối chiếu địa chỉ, quyền vào hồ và khu vực tập phù hợp.'],['Chọn đúng người','Trao đổi với giáo viên được ghi tên về mục tiêu và cách hướng dẫn.'],['Rõ các khoản phí','Tách học phí, vé hồ và các khoản sử dụng tiện ích nếu có.'],['Thống nhất lộ trình','Hỏi thời lượng, lịch tập và điều kiện đổi buổi trước khi thanh toán.']];
---
<section class="rd-section rd-guide" id="cach-chon" aria-labelledby="guide-title"><div class="sfl-container"><div class="rd-guide-grid"><div class="rd-section-heading"><span class="rd-kicker">{en?'A LITTLE PREPARATION GOES A LONG WAY':'CHUẨN BỊ TỐT CHO BUỔI HỌC ĐẦU'}</span><h2 id="guide-title">{en?'Choose a place with confidence':'Chọn nơi học bơi phù hợp'}</h2><p>{en?`Use the ${page.name} directory to compare practical details, rather than treating every listing as the same class. The pool operator and each teaching provider have different responsibilities.`:`Dùng danh bạ ${page.name} để so sánh điều kiện thực tế. Một hồ có thể có nhiều giáo viên hoặc đơn vị dạy; thông tin của một người không đại diện cho tất cả các lớp tại hồ.`}</p>{page.localAdvice&&<p class="rd-local-advice">{page.localAdvice}</p>}<a href={page.site.parentHref} class="rd-text-link">{en?'Explore the parent directory':'Xem danh bạ cấp trên'}<Icon name="arrow" /></a></div><ol class="rd-guide-steps">{steps.map(([title,text],i)=><li class="rd-guide-step"><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div><div class="rd-local-context" id="khu-vuc"><div><Icon name="pin" /><h3>{en?'Local names & directions':'Địa danh & hướng tìm đường'}</h3><p>{page.name}{page.parentName&&page.level!=='province'?`, ${page.parentName}`:''}</p>{page.previous.length>0&&<p>{en?'Names in the area dataset':'Tên khu vực trong dữ liệu'}: {page.previous.join(', ')}.</p>}<p>{en?'Older names can help identify an address, but a map search is not a verified entrance. Ask the operator which gate, building or reception to use. Nearby options are references, not a promise of travelling time.':'Tên gọi cũ có thể giúp nhận diện địa chỉ, nhưng kết quả tìm trên bản đồ không thay cho xác nhận lối vào. Hỏi rõ cổng, tòa nhà hoặc quầy tiếp nhận. Các địa điểm lân cận là lựa chọn tham khảo, không là cam kết về thời gian di chuyển.'}</p></div><div><Icon name="shield" /><h3>{en?'Access & supervision':'Quyền sử dụng & giám sát'}</h3><p>{en?'Residential, hotel and private facilities can have different admission rules. A learner’s right to enter does not automatically allow an outside teacher to conduct a lesson. Confirm both before arranging a session.':'Hồ chung cư, khách sạn hoặc cơ sở riêng có thể có nội quy tiếp nhận khác nhau. Quyền vào hồ của học viên không mặc nhiên là quyền cho giáo viên ngoài vào dạy. Cần xác nhận cả hai trước khi hẹn buổi đầu.'}</p><p>{en?'For children and nervous beginners, discuss supervision, handover arrangements and suitable practice areas. Progress depends on the learner and the actual conditions; do not rely on an image or a fixed number of sessions as a guarantee.':'Với trẻ em hoặc người còn sợ nước, trao đổi cách giám sát, đưa đón và khu tập phù hợp. Tiến độ tùy học viên và điều kiện thực tế; không dùng hình ảnh hoặc số buổi cố định làm bảo đảm.'}</p></div></div></div></section>
