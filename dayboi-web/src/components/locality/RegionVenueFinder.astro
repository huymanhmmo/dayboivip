---
import Icon from '../landing/ui/Icon.astro';
import VenueCard from './VenueCard.astro';
import type {RegionPageData} from '../../data/locality/types';
const {page}=Astro.props as {page:RegionPageData};const en=page.lang==='en';
---
<section class="rd-section rd-venue-section" id="dia-diem" aria-labelledby="region-venues-title" data-region-finder data-lang={page.lang}><div class="sfl-container"><div class="rd-section-heading"><span class="rd-kicker"><Icon name="pin" />{en?'YOUR LOCAL SWIMMING DIRECTORY':'ĐỊA ĐIỂM VÀ ĐẦU MỐI DẠY BƠI'}</span><h2 id="region-venues-title">{page.nearbyOnly?(en?'Explore nearby options':'Tham khảo hồ bơi lân cận'):(en?'Find a pool that suits you':'Tìm hồ bơi phù hợp với bạn')}</h2><p>{page.nearbyOnly?(en?`No pool is currently attached to ${page.name} in the available data. These listings are nearby references from the parent directory; confirm their location and access.`:`Dữ liệu chưa có hồ gắn trực tiếp với ${page.name}. Các địa điểm dưới đây là gợi ý từ danh bạ lân cận; cần đối chiếu vị trí và điều kiện sử dụng.`):(en?`Compare ${page.venues.length} listings serving ${page.name}. Open each card to see its operator, teachers and their own contact numbers.`:`So sánh ${page.venues.length} địa điểm tại ${page.name}. Mở thẻ để xem ban quản lý, từng giáo viên và số điện thoại riêng.`)}</p></div>
  {page.level==='province'&&<><span id="danh-sach" class="rd-anchor-alias"></span><span id="directory-list" class="rd-anchor-alias"></span><nav class="rd-group-links" aria-label={en?'Area groups':'Các nhóm địa điểm'}>{page.groups.map(g=><a id={g.id} href={g.href||'#dia-diem'} data-select-group={g.href?undefined:g.id}>{g.label}<Icon name="arrow" /></a>)}</nav></>}<form class="rd-filters" role="search" aria-label={en?'Find local swimming places':'Tìm địa điểm bơi lội'} data-region-filter-form><label class="rd-search"><Icon name="search" /><span class="sfl-sr-only">{en?'Pool name or address':'Tên hồ bơi hoặc địa chỉ'}</span><input name="q" type="search" placeholder={en?'Pool name, street or area…':'Tên hồ bơi, đường hoặc khu vực…'} autocomplete="off" /></label>{page.groups.length>1&&<label><span class="sfl-sr-only">{en?'Area group':'Nhóm khu vực'}</span><select name="group" aria-label={en?'Area group':'Nhóm khu vực'}><option value="">{en?'All areas':'Tất cả khu vực'}</option>{page.groups.map(g=><option value={g.id}>{g.label}</option>)}</select></label>}<label><span class="sfl-sr-only">{en?'Pool access':'Điều kiện sử dụng'}</span><select name="access" aria-label={en?'Pool access':'Điều kiện sử dụng'}><option value="">{en?'All pool types':'Tất cả loại hồ'}</option><option value="public">{en?'Service / public':'Dịch vụ / công cộng'}</option><option value="residential">{en?'Residential':'Nội khu cư dân'}</option><option value="unknown">{en?'Confirm access':'Cần xác nhận loại hồ'}</option></select></label><button class="rd-button rd-button--blue" type="submit">{en?'Search':'Tìm hồ bơi'}<Icon name="arrow" /></button></form>
  <p class="rd-result-count" role="status" aria-live="polite" data-region-result>{en?`${page.venues.length} places listed`:`${page.venues.length} địa điểm trong dữ liệu`}</p>
  <div class="rd-venue-grid">{page.venues.map(venue=><VenueCard venue={venue} lang={page.lang} />)}</div>
  <div class="rd-empty" data-region-empty hidden><Icon name="search" /><h3>{en?'No matching places':'Chưa tìm thấy địa điểm phù hợp'}</h3><p>{en?'Try a shorter name or remove the filters.':'Thử tên ngắn hơn hoặc bỏ bớt bộ lọc.'}</p><button type="button" class="rd-button rd-button--blue" data-region-reset>{en?'Show all places':'Xem lại tất cả địa điểm'}</button></div>
  <div class="rd-directory-note"><Icon name="people" /><p><strong>{en?'Each contact has a role':'Mỗi số liên hệ có chủ thể riêng'}</strong><span>{en?'Ask operators about admission and opening hours. Ask each named teacher about programmes, tuition and lesson availability.':'Hỏi quầy vé/BQL về giờ và quyền vào hồ. Trao đổi với từng giáo viên về chương trình, học phí và khả năng nhận lớp.'}</span></p></div>
</div></section>
<script>
  document.querySelectorAll<HTMLElement>('[data-region-finder]').forEach(section=>{
    const form=section.querySelector<HTMLFormElement>('[data-region-filter-form]');
    const cards=Array.from(section.querySelectorAll<HTMLElement>('[data-region-venue]'));
    const normalize=(value:string)=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().trim();
    const filter=()=>{if(!form)return;const data=new FormData(form),query=normalize(String(data.get('q')||'')),group=String(data.get('group')||''),access=String(data.get('access')||'');let count=0;cards.forEach(card=>{const match=query.split(/\s+/).every(part=>(card.dataset.search||'').includes(part))&&(!group||card.dataset.group===group)&&(!access||card.dataset.access===access);card.hidden=!match;if(match)count++;});const status=section.querySelector('[data-region-result]');if(status)status.textContent=section.dataset.lang==='en'?`${count} of ${cards.length} places`:`Hiển thị ${count} trên ${cards.length} địa điểm`;const empty=section.querySelector<HTMLElement>('[data-region-empty]');if(empty)empty.hidden=count>0;};
    section.querySelectorAll<HTMLAnchorElement>('[data-select-group]').forEach(link=>link.addEventListener('click',()=>{const select=form?.querySelector<HTMLSelectElement>('select[name="group"]');if(select)select.value=link.dataset.selectGroup||'';filter();}));
    form?.addEventListener('submit',event=>{event.preventDefault();filter();});form?.addEventListener('input',filter);form?.addEventListener('change',filter);
    section.querySelector('[data-region-reset]')?.addEventListener('click',()=>{form?.reset();filter();form?.querySelector('input')?.focus();});
    const revealAnchor=()=>{const id=decodeURIComponent(location.hash.slice(1));if(!id)return;const target=section.querySelector<HTMLElement>('#'+CSS.escape(id));target?.querySelector('details')?.setAttribute('open','');};revealAnchor();addEventListener('hashchange',revealAnchor);
  });
</script>
