---
import Icon from '../landing/ui/Icon.astro';
import {cleanCopy,contactPhones} from '../../data/locality/common';
const {providers=[],lang='vi'}=Astro.props;const en=lang==='en';
---
{providers.length>0&&<section class="rd-section" id="don-vi-day-boi" aria-labelledby="providers-title"><div class="sfl-container"><span id="provider-title" class="rd-anchor-alias"></span><div class="rd-section-heading"><span class="rd-kicker">{en?'LESSON PROVIDERS IN THE DIRECTORY':'ĐƠN VỊ DẠY BƠI TRONG DANH BẠ'}</span><h2 id="providers-title">{en?'Centres, clubs & teaching teams':'Trung tâm, câu lạc bộ & đội ngũ dạy bơi'}</h2><p>{en?'A teaching provider may work at several pools. Confirm the exact facility and instructor before booking.':'Một đơn vị có thể dạy tại nhiều hồ. Xác nhận cơ sở và giáo viên cụ thể trước khi đăng ký.'}</p></div><div class="rd-provider-grid">{providers.map(p=><article class="rd-provider" data-directory-contact-block="true"><span class="rd-provider-kind"><Icon name="people" />{p.kind}</span><h3>{p.name}</h3><dl>{[[en?'Areas':'Khu vực',p.areas],[en?'Learners':'Đối tượng',p.audiences],[en?'Format':'Hình thức',p.formats],[en?'Public contact':'Liên hệ công khai',contactPhones(p.contact).length?'':p.contact]].filter(([,v])=>v).map(([label,value])=><div><dt>{label}</dt><dd>{cleanCopy(value)}</dd></div>)}</dl>{contactPhones(p.contact).length>0&&<div class="rd-phone-links">{contactPhones(p.contact).map(phone=><a href={phone.href} data-directory-contact="true" aria-label={`${en?'Call':'Gọi'} ${p.name}: ${phone.label}`}><Icon name="phone" />{phone.label}</a>)}</div>}{p.verification&&<p>{cleanCopy(p.verification)}</p>}{p.missing&&<p class="rd-provider-note">{cleanCopy(p.missing)}</p>}{(p.sources||(p.sourceUrl?[{url:p.sourceUrl,label:p.sourceLabel}]:[])).map(s=><a class="rd-source" href={s.url} target="_blank" rel="noopener noreferrer">{s.label||s.title||(en?'Provider information':'Thông tin đơn vị')}<Icon name="arrow" /></a>)}</article>)}</div></div></section>}
