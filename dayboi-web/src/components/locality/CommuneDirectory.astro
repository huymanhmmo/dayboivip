---
import Icon from '../landing/ui/Icon.astro';
import type {RegionPageData} from '../../data/locality/types';
import {fold} from '../../data/locality/common';
const {page}=Astro.props as {page:RegionPageData};const en=page.lang==='en';
---
{page.communes.length>0&&<section class="rd-section rd-communes" id="xa-phuong" aria-labelledby="commune-title" data-commune-directory data-lang={page.lang}><div class="sfl-container"><span id="wards-communes" class="rd-anchor-alias"></span><div class="rd-section-heading"><span class="rd-kicker">{en?'START WITH YOUR NEIGHBOURHOOD':'TÌM GẦN NHÀ, CHỌN ĐÚNG NƠI'}</span><h2 id="commune-title">{en?`Wards & communes in ${page.name}`:`Tra cứu xã, phường tại ${page.name}`}</h2><p>{en?'Browse the current administrative names and see the local or nearby listings available for each area.':'Chọn địa phương để xem thông tin hồ trong địa bàn hoặc các lựa chọn lân cận từ danh bạ hiện có.'}</p></div><div class="rd-commune-controls"><label class="rd-search"><Icon name="search" /><span class="sfl-sr-only">{en?'Ward or commune name':'Tên xã hoặc phường'}</span><input type="search" placeholder={en?'Search a ward or commune…':'Tìm tên xã, phường…'} data-commune-query /></label><label><span class="sfl-sr-only">{en?'Listing coverage':'Thông tin địa điểm'}</span><select data-commune-coverage aria-label={en?'Listing coverage':'Thông tin địa điểm'}><option value="">{en?'All areas':'Tất cả xã, phường'}</option><option value="direct">{en?'With local listings':'Có địa điểm trong dữ liệu'}</option></select></label><span data-commune-status role="status" aria-live="polite">{page.communes.length} {en?'areas':'xã, phường'}</span></div><div class="rd-commune-grid">{page.communes.map(link=><a href={link.href} data-commune-link data-search={fold(link.label)} data-direct={link.hasVenues?'true':'false'}><span class="rd-commune-icon"><Icon name="pin" /></span><span><strong>{link.label}</strong><small>{link.hasVenues?(en?'Local pool information':'Có thông tin địa điểm'):(en?'Explore nearby options':'Tham khảo địa điểm lân cận')}</small></span><Icon name="chevron" /></a>)}</div><div class="rd-commune-bottom"><p hidden data-commune-empty>{en?'No matching area. Try another name.':'Chưa tìm thấy xã, phường phù hợp. Thử tên khác hoặc bỏ bộ lọc.'}</p><button class="rd-button rd-button--outline" type="button" data-commune-more hidden>{en?'Show more areas':'Xem thêm xã, phường'}<Icon name="chevron" /></button></div></div></section>}
<script>
  document.querySelectorAll<HTMLElement>('[data-commune-directory]').forEach(section=>{
    const links=Array.from(section.querySelectorAll<HTMLElement>('[data-commune-link]')),input=section.querySelector<HTMLInputElement>('[data-commune-query]'),select=section.querySelector<HTMLSelectElement>('[data-commune-coverage]'),more=section.querySelector<HTMLButtonElement>('[data-commune-more]');let limit=24;
    const draw=()=>{const q=(input?.value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().trim();const matches=links.filter(l=>q.split(/\s+/).every(w=>(l.dataset.search||'').includes(w))&&(!select?.value||l.dataset.direct==='true'));links.forEach(l=>l.hidden=true);matches.slice(0,limit).forEach(l=>l.hidden=false);if(more)more.hidden=matches.length<=limit;const status=section.querySelector('[data-commune-status]');if(status)status.textContent=section.dataset.lang==='en'?`${matches.length} areas`:`${matches.length} xã, phường`;const empty=section.querySelector<HTMLElement>('[data-commune-empty]');if(empty)empty.hidden=matches.length>0;};
    input?.addEventListener('input',()=>{limit=24;draw();});select?.addEventListener('change',()=>{limit=24;draw();});more?.addEventListener('click',()=>{limit+=24;draw();});draw();
  });
</script>
