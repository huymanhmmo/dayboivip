---
/** Global footer for the enterprise + independent local-directory model. */
export interface Props { lang?: 'vi' | 'en'; }

const { lang = 'vi' } = Astro.props;
const currentYear = new Date().getFullYear();
const footerNav = lang === 'vi' ? {
  brand: 'Swim For Life Việt Nam',
  tagline: 'Đơn vị thiết kế và triển khai chương trình đào tạo bơi quy mô lớn cho doanh nghiệp, trường học và khu dân cư.',
  sections: [
    { title: 'Cho Tổ Chức', links: [
      { label: 'Đào tạo doanh nghiệp', href: '/khoa-hoc-boi/doanh-nghiep/' },
      { label: 'Gửi yêu cầu chương trình', href: '/lien-he/' },
      { label: 'Năng lực đội ngũ', href: '/doi-ngu-hlv/' },
      { label: 'Giới thiệu đơn vị', href: '/gioi-thieu/' }
    ]},
    { title: 'Kỹ Thuật Bơi', links: [
      { label: 'Bơi ếch', href: '/ky-thuat-boi/hoc-boi-ech/' },
      { label: 'Bơi sải', href: '/ky-thuat-boi/hoc-boi-sai/' },
      { label: 'Bơi ngửa', href: '/ky-thuat-boi/hoc-boi-ngua/' },
      { label: 'Bơi bướm', href: '/ky-thuat-boi/hoc-boi-buom/' },
      { label: 'Kỹ năng đứng nước', href: '/ky-thuat-boi/ky-nang-dung-nuoc/' }
    ]},
    { title: 'Địa Điểm', links: [
      { label: 'Tất cả địa điểm', href: '/hoc-boi-o-dau/' },
      { label: 'Hà Nội', href: '/hoc-boi-ha-noi/' },
      { label: 'Gia Lâm, Hà Nội', href: '/hoc-boi-ha-noi/gia-lam/' },
      { label: 'Long Biên, Hà Nội', href: '/hoc-boi-ha-noi/long-bien/' },
      { label: 'TP. Hồ Chí Minh', href: '/hoc-boi-tphcm/' },
      { label: 'Đà Nẵng', href: '/hoc-boi-da-nang/' },
      { label: 'Blog kiến thức', href: '/tin-tuc/' }
    ]}
  ],
  ctaEyebrow: 'Dành cho doanh nghiệp và tổ chức',
  ctaTitle: 'Đào tạo bơi quy mô lớn, triển khai có hệ thống.',
  ctaText: 'Gửi phạm vi, số lượng học viên và địa điểm dự kiến để nhận đề xuất chương trình phù hợp.',
  consult: 'Gửi yêu cầu hợp tác',
  copyright: `© ${currentYear} Swim For Life Việt Nam. Thuộc Công ty CP Your Dreams.`
} : {
  brand: 'Swim For Life Vietnam',
  tagline: 'Large-scale swimming and water-safety programs for companies, schools and residential communities.',
  sections: [
    { title: 'Organizations', links: [
      { label: 'Organization enquiry', href: '/en/contact/' },
      { label: 'Team expertise', href: '/en/coaches/' },
      { label: 'About us', href: '/en/about/' },
      { label: 'Program overview', href: '/khoa-hoc-boi/doanh-nghiep/' }
    ]},
    { title: 'Techniques', links: [
      { label: 'Breaststroke', href: '/en/swimming-techniques/breaststroke/' },
      { label: 'Front Crawl', href: '/en/swimming-techniques/front-crawl/' },
      { label: 'Backstroke', href: '/en/swimming-techniques/backstroke/' },
      { label: 'Butterfly', href: '/en/swimming-techniques/butterfly/' }
    ]},
    { title: 'Information', links: [
      { label: 'About Us', href: '/en/about/' },
      { label: 'Coaches', href: '/en/coaches/' },
      { label: 'Blog', href: '/en/blog/' },
      { label: 'Local directory', href: '/hoc-boi-o-dau/' }
    ]}
  ],
  ctaEyebrow: 'For organizations and institutions',
  ctaTitle: 'Large-scale swimming programs, delivered systematically.',
  ctaText: 'Share your group size, locations and objectives to request a tailored program proposal.',
  consult: 'Request a proposal',
  copyright: `© ${currentYear} Swim For Life Vietnam. Part of Your Dreams JSC.`
};
---

<footer class="site-footer" id="site-footer">
  <div class="footer-cta">
    <div class="footer-cta__image" aria-hidden="true"></div>
    <div class="footer-cta__overlay" aria-hidden="true"></div>
    <div class="container footer-cta__content">
      <div>
        <span class="footer-cta__eyebrow">{footerNav.ctaEyebrow}</span>
        <h2>{footerNav.ctaTitle}</h2>
        <p>{footerNav.ctaText}</p>
      </div>
      <a href={lang === 'vi' ? '/lien-he/' : '/en/contact/'} class="footer-cta__button">
        <span>{footerNav.consult}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>
  </div>

  <div class="footer-main">
    <div class="container footer-main__grid">
      <div class="footer-brand">
        <a href={lang === 'vi' ? '/' : '/en/'} class="footer-brand__logo" aria-label={footerNav.brand}>
          <img src="/images/brand/logo.png" alt={footerNav.brand} width="200" height="55" loading="lazy" />
        </a>
        <p>{footerNav.tagline}</p>
        <div class="footer-brand__proof">
          <span>10+</span>
          <small>{lang === 'vi' ? 'năm đào tạo bơi lội' : 'years teaching swimming'}</small>
        </div>
      </div>

      <div class="footer-links">
        {footerNav.sections.map((section) => (
          <div class="footer-links__column">
            <h3>{section.title}</h3>
            <ul>{section.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
          </div>
        ))}
      </div>

    </div>

    <div class="container footer-bottom">
      <p>{footerNav.copyright} {lang === 'vi' ? 'Bảo lưu mọi quyền.' : 'All rights reserved.'}</p>
      <div>
        <a href={lang === 'vi' ? '/' : '/en/'}>{lang === 'vi' ? 'Trang chủ' : 'Home'}</a>
        <a href="https://dayboi.vip" target="_blank" rel="noopener noreferrer">dayboi.vip</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; background: var(--blue-950); color: var(--white); }
  .footer-cta { position: relative; min-height: 420px; display: grid; align-items: end; overflow: hidden; }
  .footer-cta__image, .footer-cta__overlay { position: absolute; inset: 0; }
  .footer-cta__image { background: url('/images/classes/lop-hoc-boi-vui-ve-tran-ngap-tieng-cuoi.jpg') center 42% / cover no-repeat; transform: scale(1.01); }
  .footer-cta__overlay { background: linear-gradient(90deg, color-mix(in srgb, var(--blue-950) 96%, transparent), color-mix(in srgb, var(--blue-950) 80%, transparent) 55%, color-mix(in srgb, var(--blue-950) 35%, transparent)); }
  .footer-cta__content { position: relative; z-index: 1; min-height: 420px; display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-10); padding-block: clamp(4rem, 8vw, 6rem); }
  .footer-cta__content > div { max-width: 720px; }
  .footer-cta__eyebrow { display: inline-block; margin-bottom: var(--space-4); color: var(--blue-200); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .footer-cta h2 { color: var(--white); font-size: clamp(2.35rem, 5vw, 4.5rem); letter-spacing: -.05em; }
  .footer-cta p { max-width: 620px; margin: var(--space-5) 0 0; color: color-mix(in srgb, var(--white) 78%, transparent); font-size: var(--text-lg); }
  .footer-cta__button { min-height: 58px; display: inline-flex; align-items: center; justify-content: center; gap: var(--space-3); padding-inline: var(--space-6); border-radius: var(--radius-md); background: var(--orange-500); color: var(--white); font-weight: 750; white-space: nowrap; }
  .footer-cta__button:hover { background: var(--orange-600); color: var(--white); transform: translateY(-2px); }
  .footer-cta__button svg { width: 20px; fill: none; stroke: currentColor; stroke-width: 2; }

  .footer-main { padding-block: clamp(4rem, 7vw, 6rem) var(--space-6); background: var(--blue-950); }
  .footer-main__grid { display: grid; grid-template-columns: minmax(240px, .8fr) minmax(0, 2.2fr); gap: clamp(2.5rem, 7vw, 7rem); }
  .footer-brand__logo { display: inline-flex; padding: var(--space-3); border-radius: var(--radius-md); background: var(--white); }
  .footer-brand__logo img { width: auto; height: 42px; }
  .footer-brand > p { max-width: 360px; margin: var(--space-5) 0; color: color-mix(in srgb, var(--white) 62%, transparent); font-size: .9rem; }
  .footer-brand__proof { display: flex; align-items: center; gap: var(--space-3); }
  .footer-brand__proof span { color: var(--blue-400); font-family: var(--font-heading); font-size: 2rem; font-weight: 800; }
  .footer-brand__proof small { max-width: 100px; color: color-mix(in srgb, var(--white) 60%, transparent); line-height: 1.35; }
  .footer-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .footer-links h3 { margin-bottom: var(--space-5); color: var(--white); font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; }
  .footer-links ul { display: grid; gap: .7rem; }
  .footer-links a { color: color-mix(in srgb, var(--white) 62%, transparent); font-size: .86rem; }
  .footer-links a:hover { color: var(--blue-200); }
  .footer-contact { display: flex; flex-direction: column; align-items: flex-start; }
  .footer-contact__label { margin-bottom: var(--space-3); color: color-mix(in srgb, var(--white) 50%, transparent); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .footer-contact__phone { margin-bottom: var(--space-5); color: var(--white); font-family: var(--font-heading); font-size: clamp(1.45rem, 2vw, 2rem); font-weight: 800; letter-spacing: -.04em; }
  .footer-contact__row { min-height: 44px; display: inline-flex; align-items: center; gap: var(--space-3); color: color-mix(in srgb, var(--white) 67%, transparent); font-size: .86rem; }
  .footer-contact__row:hover { color: var(--blue-200); }
  .footer-contact__row svg { width: 18px; fill: none; stroke: var(--blue-400); stroke-width: 1.7; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-16); padding-top: var(--space-6); border-top: 1px solid color-mix(in srgb, var(--white) 10%, transparent); }
  .footer-bottom p, .footer-bottom a { margin: 0; color: color-mix(in srgb, var(--white) 43%, transparent); font-size: .75rem; }
  .footer-bottom > div { display: flex; gap: var(--space-5); }
  .footer-bottom a:hover { color: var(--white); }

  .contact-dock { position: fixed; inset-inline-end: var(--space-5); inset-block-end: var(--space-5); z-index: var(--z-fixed); display: flex; flex-direction: column; gap: var(--space-2); }
  .contact-dock a { min-width: 52px; min-height: 52px; display: flex; align-items: center; justify-content: center; gap: var(--space-2); padding-inline: var(--space-4); border-radius: var(--radius-full); background: var(--blue-600); color: var(--white); box-shadow: var(--shadow-lg); font-size: .78rem; font-weight: 750; }
  .contact-dock a:last-child { background: var(--orange-500); }
  .contact-dock a:hover { color: var(--white); transform: translateY(-2px); }
  .contact-dock svg { width: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; }

  @media (max-width: 1024px) {
    .footer-cta__content { align-items: flex-start; justify-content: flex-end; flex-direction: column; }
    .footer-main__grid { grid-template-columns: 1fr 2fr; }
    .footer-contact { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, auto); align-items: center; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid color-mix(in srgb, var(--white) 10%, transparent); }
    .footer-contact__label { grid-column: 1 / -1; margin: 0; }
    .footer-contact__phone { margin: 0; }
  }

  @media (max-width: 720px) {
    .footer-cta, .footer-cta__content { min-height: 500px; }
    .footer-cta__overlay { background: linear-gradient(0deg, var(--blue-950) 4%, color-mix(in srgb, var(--blue-950) 78%, transparent) 66%, color-mix(in srgb, var(--blue-950) 35%, transparent)); }
    .footer-cta__button { width: 100%; }
    .footer-main__grid { grid-template-columns: 1fr; }
    .footer-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-links__column:last-child { grid-column: 1 / -1; }
    .footer-contact { grid-template-columns: 1fr; }
    .footer-bottom { align-items: flex-start; flex-direction: column; margin-top: var(--space-10); }
    .contact-dock { inset-inline: var(--space-3); inset-block-end: var(--space-3); flex-direction: row; }
    .contact-dock a { flex: 1; border-radius: var(--radius-md); }
  }
</style>
