---
import PageLayout from './PageLayout.astro';
import CourseHero from '../components/course/CourseHero.astro';
import CourseOverview from '../components/course/CourseOverview.astro';
import CourseProblem from '../components/course/CourseProblem.astro';
import CourseUSP from '../components/course/CourseUSP.astro';
import CourseCurriculum from '../components/course/CourseCurriculum.astro';
import CourseStats from '../components/course/CourseStats.astro';
import CourseInstructor from '../components/course/CourseInstructor.astro';
import CourseTestimonial from '../components/course/CourseTestimonial.astro';
import CourseGallery from '../components/course/CourseGallery.astro';
import CoursePricing from '../components/course/CoursePricing.astro';
import CourseTrust from '../components/course/CourseTrust.astro';
import CourseFAQ from '../components/course/CourseFAQ.astro';
import CourseSiloNav from '../components/course/CourseSiloNav.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
import CoachesSection from '../components/CoachesSection.astro';
import LocalDirectoryCTA from '../components/LocalDirectoryCTA.astro';

import '../styles/course-landing.css';
import '../styles/template-redesign.css';

export interface Props {
  course: {
    slug: string;
    title: string;
    shortTitle: string;
    subtitle: string;
    description: string;
    targetAudience: string;
    duration: string;
    sessionLength: string;
    classSize: string;
    heroImage: string;
    priceFrom: string;
    stats: Array<{ number: number; suffix: string; label: string }>;
    problems: {
      title: string;
      subtitle: string;
      items: Array<{ icon: string; title: string; description: string }>;
    };
    benefits: Array<{ icon: string; title: string; description: string }>;
    overview: Array<{ icon: string; label: string; value: string }>;
    curriculum: {
      title: string;
      stages: Array<{
        phase: string;
        title: string;
        sessions: string;
        items: string[];
      }>;
    };
    instructor: {
      name: string;
      title: string;
      experience: string;
      certifications: string[];
      quote: string;
    };
    pricing: {
      note: string;
      tiers: Array<{
        name: string;
        highlight: boolean;
        badge?: string;
        price: string;
        period: string;
        features: string[];
        cta: string;
      }>;
    };
    testimonials: Array<{
      name: string;
      detail: string;
      rating: number;
      text: string;
    }>;
    faqs: Array<{
      question: string;
      answer: string;
    }>;
  };
  breadcrumbs: Array<{ label: string; href?: string }>;
  schema?: any;
  lang?: 'vi' | 'en';
  alternateUrl?: string;
  alternateLang?: 'vi' | 'en';
}

const { course, breadcrumbs, schema, lang = 'vi', alternateUrl, alternateLang } = Astro.props;
const isEnterprise = course.slug === 'doanh-nghiep' || course.slug === 'corporate';
---

<PageLayout
  title={course.title}
  description={course.description}
  canonical={lang === 'vi' ? `https://dayboi.vip/khoa-hoc-boi/${course.slug}/` : `https://dayboi.vip/en/courses/${course.slug}/`}
  image={course.heroImage}
  type="article"
  breadcrumbs={breadcrumbs}
  schema={schema}
  lang={lang}
  alternateUrl={alternateUrl}
  alternateLang={alternateLang}
>
  <div class="course-landing">
    <!-- Hero Section (Attention) -->
    <CourseHero 
      title={course.title}
      subtitle={course.subtitle}
      description={course.description}
      image={course.heroImage}
      stats={course.stats}
      slug={course.slug}
      lang={lang}
      isEnterprise={isEnterprise}
    />

    <!-- Quick Info Grid (Interest) -->
    <CourseOverview 
      overview={course.overview}
      slug={course.slug}
      lang={lang}
    />

    <!-- Problem Section (Interest) -->
    <CourseProblem 
      problems={course.problems}
      lang={lang}
    />

    <!-- Benefits / Unique Value Proposition (Desire) -->
    <CourseUSP 
      benefits={course.benefits}
      lang={lang}
    />

    <!-- Curriculum Section (Desire) -->
    <CourseCurriculum 
      curriculum={course.curriculum}
      lang={lang}
    />

    <!-- Animated Statistics Banner (Action / Social Proof) -->
    <CourseStats 
      stats={course.stats}
    />

    <!-- Instructor Showcase -->
    {lang === 'en' ? (
      <CourseInstructor 
        instructor={course.instructor}
        lang={lang}
      />
    ) : (
      <CoachesSection />
    )}

    <!-- Testimonials Section (Social Proof) -->
    <CourseTestimonial 
      testimonials={course.testimonials}
      lang={lang}
    />

    <!-- Class Gallery Section -->
    <CourseGallery 
      slug={course.slug}
      lang={lang}
    />

    <!-- Pricing Tables (Action) -->
    {isEnterprise && <CoursePricing pricing={course.pricing} lang={lang} />}

    {isEnterprise && <CourseTrust lang={lang} />}

    <!-- FAQ Accordion -->
    <CourseFAQ 
      faqs={course.faqs}
      lang={lang}
    />

    <!-- SEO Silo Hub-and-Spoke Navigation -->
    <CourseSiloNav currentSlug={course.slug} lang={lang} />

    {isEnterprise ? (
    <section class="cl-section cl-section--alt" id="yeu-cau-hop-tac">
      <div class="cl-section__container">
        <div class="cl-section-title">
          <span class="cl-section-title__badge">
            {lang === 'vi' ? 'Yêu cầu hợp tác' : 'Organization enquiry'}
          </span>
          <h2 class="cl-section-title__heading">
            {lang === 'vi' ? 'Nhận Đề Xuất Chương Trình Theo Quy Mô' : 'Request a Program Designed for Your Scale'}
          </h2>
          <p class="cl-section-title__sub">
            {lang === 'vi' ? 'Biểu mẫu dành riêng cho doanh nghiệp, trường học, khu dân cư và đoàn thể có từ 10 học viên.' : 'This form is exclusively for organizations, schools, residential communities and groups of 10 or more.'}
          </p>
          <span class="cl-section-title__decoration"></span>
        </div>

        <div class="cl-form-container">
          <div class="cl-form-info">
            <h3 class="cl-form-info__title">{lang === 'vi' ? 'Hotline & Zalo Tiếp Nhận Doanh Nghiệp' : 'Direct Enterprise Contact'}</h3>
            <p class="cl-form-info__text">
              {lang === 'vi' ? 'Kênh tiếp nhận trực tiếp dành cho đại diện Doanh nghiệp, Đoàn thể, Trường học và Ban Quản trị Khu dân cư / Khu đô thị:' : 'Direct channel for Corporate Representatives, Institutions, Schools, and Residential Boards:'}
            </p>
            <div style="margin: 16px 0; padding: 18px; background: rgba(0, 119, 182, 0.08); border-left: 4px solid #0077b6; border-radius: 8px;">
              <p style="margin: 0 0 8px 0; font-size: 1.2rem; font-weight: 700; color: #0077b6;">
                📞 Hotline / Zalo: <a href="tel:0979121097" style="color: #0077b6; text-decoration: underline;">0979.121.097</a>
              </p>
              <p style="margin: 0 0 6px 0; font-size: 0.95rem;">
                <strong>Thầy Nguyễn Huy Mạnh</strong> - Giám đốc đào tạo Swim For Life
              </p>
              <div style="margin-top: 10px; display: flex; gap: 10px; flex-wrap: wrap;">
                <a href="tel:0979121097" class="cl-btn cl-btn-primary" style="padding: 8px 16px; font-size: 0.9rem;">
                  <span>📞 Gọi Trực Tiếp</span>
                </a>
                <a href="https://zalo.me/0979121097" target="_blank" rel="noopener noreferrer" class="cl-btn cl-btn-zalo" style="padding: 8px 16px; font-size: 0.9rem;">
                  <span>💬 Chat Zalo Hợp Tác</span>
                </a>
              </div>
              <p style="margin: 12px 0 0 0; font-size: 0.82rem; color: #d90429; font-weight: 600; line-height: 1.4;">
                ⚠️ {lang === 'vi' ? 'LƯU Ý: Số điện thoại này CHỈ tiếp nhận khách hàng Doanh nghiệp, Tập thể, Nhóm lớn, Ban quản lý Khu dân cư / Khu đô thị (từ 10 người trở lên). Trung tâm không tiếp nhận tư vấn khách hàng cá nhân qua số này.' : 'NOTE: This contact is EXCLUSIVELY for Corporate, Organization, and Large Group/Community contracts (10+ learners). We do not accept individual learner inquiries here.'}
              </p>
            </div>
            <p class="cl-form-info__text" style="font-size: 0.88rem; color: var(--color-text-muted);">
              {lang === 'vi' ? 'Hoặc điền biểu mẫu kế bên, chúng tôi sẽ liên hệ lại gửi báo giá và kế hoạch đào tạo chi tiết trong vòng 24h.' : 'Or fill out the form, and our training director will reach out with a detailed proposal within 24 hours.'}
            </p>
          </div>
          
          <div class="cl-form-wrapper">
            <RegistrationForm id="course-register-form" className="cl-astro-form" lang={lang} />
          </div>
        </div>
      </div>
    </section>
    ) : (
      <section class="cl-section cl-section--alt"><div class="cl-section__container"><LocalDirectoryCTA lang={lang} /></div></section>
    )}
  </div>
</PageLayout>

<script>
  // Intersection Observer for scroll animations (.cl-animate)
  const setupAnimations = () => {
    const animElements = document.querySelectorAll('.course-landing .cl-animate');
    
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -50px 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('cl-visible');
          // Once animated, we don't need to observe it anymore
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    animElements.forEach(el => observer.observe(el));
  };

  // Stats counter animation (data-counter)
  const setupCounters = () => {
    const counterElements = document.querySelectorAll('.course-landing [data-counter]');

    const animateCounter = (el: HTMLElement) => {
      const target = parseInt(el.getAttribute('data-target') || '0', 10);
      const suffix = el.getAttribute('data-suffix') || '';
      const duration = 2000; // 2 seconds
      const startTime = performance.now();

      const updateCount = (currentTime: number) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        // Easing function (easeOutQuad)
        const easeProgress = progress * (2 - progress);
        
        const currentValue = Math.floor(easeProgress * target);
        
        // Format with thousand separator for VN locale
        el.textContent = currentValue.toLocaleString('vi-VN') + suffix;

        if (progress < 1) {
          requestAnimationFrame(updateCount);
        } else {
          el.textContent = target.toLocaleString('vi-VN') + suffix;
        }
      };

      requestAnimationFrame(updateCount);
    };

    const observerOptions = {
      root: null,
      threshold: 0.2
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          if (!el.classList.contains('counted')) {
            el.classList.add('counted');
            animateCounter(el);
          }
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    counterElements.forEach(el => observer.observe(el));
  };

  // Run on page load
  document.addEventListener('DOMContentLoaded', () => {
    setupAnimations();
    setupCounters();
  });

  // Execute immediately in case DOMContentLoaded has already fired
  setupAnimations();
  setupCounters();
</script>

