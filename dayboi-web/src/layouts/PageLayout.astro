---
import MainLayout from './MainLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  schema?: object;
}

const { title, description, canonical, image, type, noindex, breadcrumbs, schema } = Astro.props;
---

<MainLayout 
  title={title} 
  description={description} 
  canonicalUrl={canonical} 
  ogImage={image} 
  noIndex={noindex}
  schema={schema}
  lang="vi"
>
  <Header slot="header" lang="vi" currentPath={Astro.url.pathname} />

  <!-- Breadcrumb -->
  {breadcrumbs && breadcrumbs.length > 0 && (
    <nav class="breadcrumb" aria-label="Breadcrumb" style={`padding-top: calc(var(--header-height) + var(--space-4)); background: var(--color-bg-alt);`}>
      <div class="container container-wide">
        <ol class="breadcrumb-list">
          {breadcrumbs.map((item, index) => (
            <li class="breadcrumb-item">
              {index > 0 && <span class="breadcrumb-separator">›</span>}
              {item.href ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span>{item.label}</span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )}

  <slot />

  <Footer slot="footer" lang="vi" />
</MainLayout>
