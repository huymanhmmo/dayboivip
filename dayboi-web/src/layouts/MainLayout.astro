---
/**
 * MainLayout.astro — Layout chính cho toàn bộ website
 * Xử lý: HTML shell, SEO meta, hreflang, Google Fonts, global CSS
 */
import '../styles/global.css';
import '../styles/design-system.css';
import { getAlternateUrl } from '../utils/i18nRouting.js';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: 'vi' | 'en';
  canonicalUrl?: string;
  alternateUrl?: string;
  alternateLang?: 'vi' | 'en';
  schema?: object;
  noIndex?: boolean;
}

const {
  title,
  description = 'Hướng dẫn học bơi, kỹ thuật bơi và danh bạ lớp học bơi theo địa phương. Tìm nơi học phù hợp cho trẻ em, người lớn và tổ chức.',
  ogImage = '/og-image.jpg',
  lang = 'vi',
  canonicalUrl,
  alternateUrl,
  alternateLang,
  schema,
  noIndex = false,
} = Astro.props;

const siteName = lang === 'vi' ? 'Swim For Life Việt Nam' : 'Swim For Life Vietnam';
const titleWithoutRepeatedBrand = title
  .replace(/\s*\|\s*Swim For Life Việt Nam\s*$/i, '')
  .replace(/\s*\|\s*Swim For Life Vietnam\s*$/i, '')
  .replace(/\s*\|\s*Swim For Life\s*$/i, '');
const shortBrand = lang === 'vi' ? 'Swim For Life' : 'Swim For Life Vietnam';
const titleAlreadyHasBrand = titleWithoutRepeatedBrand.toLowerCase().includes('swim for life');
const fullTitle = titleAlreadyHasBrand || titleWithoutRepeatedBrand.length > 43
  ? titleWithoutRepeatedBrand
  : `${titleWithoutRepeatedBrand} | ${shortBrand}`;
const siteUrl = 'https://dayboi.vip';
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const effectiveAlternateUrl = alternateUrl || getAlternateUrl(Astro.url.pathname, lang);
---

<!DOCTYPE html>
<html lang={lang} dir="ltr">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-27V6XCZMHF"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-27V6XCZMHF');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- SEO Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow'} />
  <link rel="canonical" href={currentUrl} />
  
  <!-- Hreflang Tags for Multilingual SEO -->
  {lang === 'vi' && (
    <>
      <link rel="alternate" hreflang="vi" href={currentUrl} />
      {effectiveAlternateUrl && <link rel="alternate" hreflang="en" href={new URL(effectiveAlternateUrl, siteUrl).href} />}
      <link rel="alternate" hreflang="x-default" href={currentUrl} />
    </>
  )}
  {lang === 'en' && (
    <>
      <link rel="alternate" hreflang="en" href={currentUrl} />
      {effectiveAlternateUrl && <link rel="alternate" hreflang="vi" href={new URL(effectiveAlternateUrl, siteUrl).href} />}
      <link rel="alternate" hreflang="x-default" href={new URL(effectiveAlternateUrl || '/', siteUrl).href} />
    </>
  )}
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  
  <!-- Google Fonts: Be Vietnam Pro + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  
  <!-- JSON-LD Schema -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main-content">{lang === 'vi' ? 'Bỏ qua đến nội dung chính' : 'Skip to main content'}</a>
  <slot name="header" />
  
  <main id="main-content">
    <slot />
  </main>
  
  <slot name="footer" />
  
  <!-- Scroll Reveal Script -->
  <script>
    // IntersectionObserver for scroll reveal animations
    const revealElements = document.querySelectorAll('.reveal');
    if (revealElements.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );
      revealElements.forEach((el) => observer.observe(el));
    }
  </script>
</body>
</html>
