---
/**
 * hoc-boi-ha-noi.astro — Trang Đăng Ký Lớp Học Bơi Hà Nội Premium
 * SEO Target: học bơi Hà Nội, dạy bơi Hà Nội, trung tâm dạy bơi Hà Nội
 */
import PageLayout from '../layouts/PageLayout.astro';
import RegistrationForm from '../components/RegistrationForm.astro';

const currentYear = new Date().getFullYear();

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Học bơi Hà Nội' },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Học Bơi Hà Nội: Trung Tâm Dạy Bơi Kèm Riêng Uy Tín Cam Kết 100% Biết Bơi",
  "description": "Lớp học bơi Hà Nội chuyên nghiệp tại Swim For Life Việt Nam. Lớp dạy học bơi kèm riêng biệt 1 kèm 1 cho trẻ em & người lớn tại các quận Hà Nội. Học thử miễn phí.",
  "author": {
    "@type": "Person",
    "name": "Thầy Nguyễn Huy Mạnh",
    "jobTitle": "Giám đốc đào tạo",
    "affiliation": {
      "@type": "Organization",
      "name": "Swim For Life Việt Nam"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Swim For Life Việt Nam",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dayboi.vip/images/brand/logo.png"
    }
  },
  "datePublished": "2026-01-25",
  "dateModified": "2026-06-10",
  "image": "https://dayboi.vip/images/classes/lop-hoc-boi-ha-noi.jpg",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://dayboi.vip/hoc-boi-ha-noi/"
  }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Trung tâm dạy bơi Swim For Life Việt Nam - Chi nhánh Hà Nội",
  "description": "Khóa học bơi chuyên nghiệp dạy kèm riêng tại khu vực Hà Nội. Cam kết biết bơi hoàn toàn.",
  "telephone": "0979121097",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Hà Nội",
    "addressCountry": "VN"
  },
  "url": "https://dayboi.vip/hoc-boi-ha-noi/",
  "image": "https://dayboi.vip/images/classes/lop-hoc-boi-ha-noi.jpg",
  "priceRange": "Liên hệ nhận báo giá"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Swim For Life dạy bơi ở những bể bơi nào tại Hà Nội?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Chúng tôi dạy tại nhiều bể bơi đối tác chất lượng cao như: Tăng Bạt Hổ (Hai Bà Trưng), Bảo Sơn (Đống Đa), Hapulico (Thanh Xuân), Bách Khoa (Hai Bà Trưng), Times City và các bể bơi thuộc hệ sinh thái Vinhomes tại Ocean Park, Smart City, Royal City."
      }
    },
    {
      "@type": "Question",
      "name": "Học bơi ở Hà Nội giá bao nhiêu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Học phí dao động tùy thuộc vào hình thức học (1 kèm 1 riêng biệt hoặc nhóm nhỏ 2-3 học viên) và vé vào bể bơi. Vui lòng liên hệ Hotline 0979.121.097 hoặc nhắn tin Zalo để nhận báo giá chi tiết và xếp lịch học thử 1 buổi hoàn toàn miễn phí."
      }
    },
    {
      "@type": "Question",
      "name": "Học bơi mùa đông tại Hà Nội có được không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hoàn toàn được! Swim For Life hợp tác với chuỗi bể bơi nước ấm 4 mùa cao cấp như Hapulico, Bảo Sơn, Times City giúp duy trì các lớp học bơi ấm áp ngay cả giữa mùa đông miền Bắc."
      }
    }
  ]
};

const combinedSchema = [articleSchema, localBusinessSchema, faqSchema];

const pools = [
  { 
    name: "Bể bơi Tăng Bạt Hổ", 
    address: "30 Tăng Bạt Hổ, Hai Bà Trưng, Hà Nội", 
    type: "Trong nhà & Ngoài trời nước ấm", 
    pros: "Bể bơi tiêu chuẩn cao cấp, không gian rộng rãi thoáng đãng, hệ thống lọc nước tuần hoàn hiện đại liên tục, cực kỳ sạch sẽ.",
    badge: "Bể bơi trọng điểm"
  },
  { 
    name: "Bể bơi Hapulico", 
    address: "83 Vũ Trọng Phụng, Thanh Xuân, Hà Nội", 
    type: "Bể bơi nước mặn 4 mùa trong nhà", 
    pros: "Hệ thống nước mặn điện phân muối đỉnh cao không dùng hóa chất Clo, nước ấm quanh năm, thiết kế cực kỳ hiện đại và sang trọng.",
    badge: "Nước mặn cao cấp"
  },
  { 
    name: "Bể bơi Khách sạn Bảo Sơn", 
    address: "50 Nguyễn Chí Thanh, Đống Đa, Hà Nội", 
    type: "Trong nhà nước ấm 4 mùa", 
    pros: "Nước ấm nhiệt độ tiêu chuẩn ổn định, thiết kế kín gió hoàn toàn, dịch vụ chuyên nghiệp, lý tưởng cho trẻ nhỏ học bơi quanh năm.",
    badge: "Kín gió, ấm áp"
  },
  { 
    name: "Bể bơi Đại học Bách Khoa", 
    address: "Số 1 Đại Cồ Việt, Hai Bà Trưng, Hà Nội", 
    type: "Ngoài trời tiêu chuẩn lớn", 
    pros: "Kích thước tiêu chuẩn thi đấu Olympic (50m), không gian thoáng mát nhiều cây xanh, chi phí vé vào hợp lý.",
    badge: "Giá bình dân"
  },
  { 
    name: "Bể bơi Vinhomes Times City", 
    address: "458 Minh Khai, Hai Bà Trưng, Hà Nội", 
    type: "Nội khu cao cấp trong nhà", 
    pros: "Chỉ dành riêng cho cư dân và học viên đăng ký qua trung tâm. Bể cực rộng, nước trong sạch, phòng tắm tráng hiện đại.",
    badge: "Cư dân & Học viên"
  }
];

const coaches = [
  {
    name: "Thầy Nguyễn Huy Mạnh",
    role: "Giám Đốc Đào Tạo Swim For Life",
    desc: "Cựu vận động viên cấp cao, hơn 12 năm kinh nghiệm huấn luyện bơi lội chuyên nghiệp và cứu hộ cứu nạn. Đã trực tiếp đào tạo hơn 3000+ học viên.",
    img: "/images/coaches/giam-doc-nguyen-huy-manh.jpg",
    tags: ["HLV Trưởng", "Cứu Hộ Quốc Gia"]
  },
  {
    name: "Thầy Đức Mạnh",
    role: "Huấn Luyện Viên Cao Cấp",
    desc: "Tốt nghiệp chuyên ngành Giáo dục Thể chất ĐH Sư phạm. Chuyên gia bơi trị liệu, sửa lỗi kỹ thuật bơi sai, hướng dẫn kỹ năng bơi sinh tồn cho trẻ nhỏ.",
    img: "/images/coaches/hlv-chuyen-mon-cao-tam-ly-vui-ve.jpeg",
    tags: ["HLV Cao cấp", "Sửa lỗi kỹ thuật"]
  },
  {
    name: "Cô Thanh Hằng",
    role: "Huấn Luyện Viên Trẻ Em",
    desc: "Nữ giáo viên giàu kinh nghiệm, cực kỳ tâm lý, kiên nhẫn. Chuyên phụ trách các bé sợ nước, các khóa bơi cơ bản giúp bé tự tin nhanh chóng.",
    img: "/images/coaches/giao-vien-vui-ve-tam-ly.jpeg",
    tags: ["HLV Nữ", "Chuyên bơi trẻ em"]
  }
];
---

<PageLayout
  title={`Học Bơi Hà Nội: Khóa Học Bơi Uy Tín Nhất [${currentYear}]`}
  description="Lớp học bơi Hà Nội tại Swim For Life Việt Nam. Lớp dạy học bơi kèm riêng biệt 1 kèm 1 cho trẻ em & người lớn tại các quận Hà Nội. Cam kết biết bơi 100%, HLV kèm riêng tận tâm."
  canonical="https://dayboi.vip/hoc-boi-ha-noi/"
  image="/images/classes/lop-hoc-boi-ha-noi.jpg"
  type="article"
  breadcrumbs={breadcrumbs}
  schema={combinedSchema}
>

  <!-- ============================================
       HERO SECTION — Premium Full Width Split Screen
       ============================================ -->
  <section class="hanoi-hero">
    <div class="hanoi-hero__bg">
      <div class="hanoi-hero__bg-gradient"></div>
      <div class="hanoi-hero__bubbles" aria-hidden="true">
        <span class="bubble bubble--1"></span>
        <span class="bubble bubble--2"></span>
        <span class="bubble bubble--3"></span>
        <span class="bubble bubble--4"></span>
        <span class="bubble bubble--5"></span>
      </div>
    </div>
    <div class="container hanoi-hero__grid">
      <div class="hanoi-hero__text reveal">
        <div class="hanoi-hero__badge">
          <span class="hanoi-hero__badge-dot"></span>
          Trung Tâm Dạy Học Bơi Uy Tín Số 1 Hà Nội
        </div>
        <h1 class="hanoi-hero__title">
          Dạy Học Bơi <br/>
          <span class="text-gradient">Hà Nội</span> — Kèm Riêng<br/>
          <span class="text-accent">Cam Kết Biết Bơi 100%</span>
        </h1>
        <p class="hanoi-hero__desc">
          Swim For Life Việt Nam mang đến các khóa học bơi chất lượng vượt trội tại Thủ đô Hà Nội. 
          HLV kèm riêng tận tâm dưới nước, thiết lập giáo trình riêng cho từng học viên, giúp bạn tự tin bơi lội an toàn sau 10-12 buổi.
        </p>
        
        <div class="hanoi-hero__value-props">
          <div class="v-prop">
            <span class="v-prop__icon">🏆</span>
            <div class="v-prop__content">
              <strong>Học thử 1 buổi miễn phí</strong>
              <span>Trải nghiệm dịch vụ & đánh giá mức độ tự tin trước khi đăng ký</span>
            </div>
          </div>
          <div class="v-prop">
            <span class="v-prop__icon">🛡️</span>
            <div class="v-prop__content">
              <strong>Cam kết 100% biết bơi thành thạo</strong>
              <span>Dạy tiếp miễn phí nếu học viên chưa biết bơi sau khóa học</span>
            </div>
          </div>
        </div>

        <div class="hanoi-hero__actions">
          <a href="https://zalo.me/0979121097" target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--lg btn--pulse">
            💬 Chat Nhận Lịch Học Thử
          </a>
          <a href="#pools-section" class="btn btn--hero-outline btn--lg">
            🏊 Xem Bể Bơi Gần Bạn
          </a>
        </div>
      </div>

      <div class="hanoi-hero__visual reveal">
        <div class="hanoi-hero__image-wrapper">
          <img 
            src="/images/classes/lop-hoc-boi-ha-noi.jpg" 
            alt="Lớp dạy bơi kèm riêng chuyên nghiệp tại Hà Nội - Swim For Life Việt Nam" 
            class="hanoi-hero__img"
            loading="eager"
          />
          <div class="hanoi-hero__glass-card">
            <span class="glass-card__icon">🌟</span>
            <div>
              <strong>Chi Nhánh Hà Nội</strong>
              <span>50+ Bể bơi hợp tác khắp 12 quận</span>
            </div>
          </div>
          <div class="hanoi-hero__glass-card hanoi-hero__glass-card--bottom">
            <span class="glass-card__icon">💯</span>
            <div>
              <strong>Cam Kết 100%</strong>
              <span>Học viên biết bơi và vững kỹ năng</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       STATISTICS SECTION (FULL WIDTH)
       ============================================ -->
  <section class="section hanoi-stats-section">
    <div class="container container--wide">
      <div class="hanoi-stats-grid reveal">
        <div class="stat-item">
          <span class="stat-item__num">99.8%</span>
          <span class="stat-item__label">Học viên biết bơi hoàn toàn</span>
        </div>
        <div class="stat-item">
          <span class="stat-item__num">50+</span>
          <span class="stat-item__label">Bể bơi chất lượng cao tại Hà Nội</span>
        </div>
        <div class="stat-item">
          <span class="stat-item__num">12+</span>
          <span class="stat-item__label">Năm kinh nghiệm đào tạo</span>
        </div>
        <div class="stat-item">
          <span class="stat-item__num">3000+</span>
          <span class="stat-item__label">Học viên tốt nghiệp hàng năm</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       INTRO SECTION with Large Image (Full Width Alt)
       ============================================ -->
  <section class="section section--alt hanoi-intro-section">
    <div class="container">
      <div class="hanoi-intro-grid reveal">
        <div class="hanoi-intro-text">
          <span class="section__badge">Về Lớp Học</span>
          <h2 class="section__title">Giải Pháp Học Bơi <span class="text-gradient">An Toàn & Hiệu Quả</span> Tại Thủ Đô</h2>
          <p class="about-text">
            Với mật độ dân cư đông đúc và nhiều sông hồ, kỹ năng bơi lội tại Hà Nội không chỉ là môn thể thao rèn luyện sức khỏe mà còn là <strong>kỹ năng sinh tồn bắt buộc</strong> cho trẻ em và người lớn. 
          </p>
          <p class="about-text">
            <strong>Swim For Life Việt Nam</strong> cung cấp hình thức dạy bơi kèm riêng biệt (1 HLV kèm tối đa 2 học viên), giúp giáo viên bám sát học viên 100% thời gian dưới nước, khắc phục chứng sợ nước và sửa lỗi động tác chính xác từng milimet. Học viên được chủ động chọn bể bơi gần nhà và sắp xếp lịch học linh hoạt theo thời gian biểu của bản thân.
          </p>
          
          <div class="hanoi-intro-features">
            <div class="intro-feat">
              <span class="intro-feat__icon">✅</span>
              <span>HLV chuyên nghiệp tốt nghiệp ĐH Thể dục Thể thao, có chứng chỉ cứu hộ quốc gia.</span>
            </div>
            <div class="intro-feat">
              <span class="intro-feat__icon">✅</span>
              <span>Thời gian học linh hoạt, đăng ký học từ 6h00 đến 21h00 hàng ngày.</span>
            </div>
            <div class="intro-feat">
              <span class="intro-feat__icon">✅</span>
              <span>Được chọn giáo viên Nam hoặc Nữ tùy theo nhu cầu học viên.</span>
            </div>
          </div>
        </div>
        <div class="hanoi-intro-image-wrap">
          <img 
            src="/images/classes/lop-boi-cu-dan-nhi-vinhomes.jpg" 
            alt="Lớp dạy bơi cho trẻ em và cư dân tại Vinhomes Hà Nội" 
            class="hanoi-intro-img"
            loading="lazy"
          />
          <div class="img-caption">Lớp học bơi cho bé năng động tại khu đô thị Vinhomes Hà Nội</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       PARTNER POOLS GRID — Fully Extended Width
       ============================================ -->
  <section class="section hanoi-pools-section" id="pools-section">
    <div class="container container--wide">
      <div class="section__header text-center reveal">
        <span class="section__badge">Hệ Thống Bể Bơi</span>
        <h2 class="section__title">Danh Sách Bể Bơi Đối Tác <span class="text-gradient">Khắp Hà Nội</span></h2>
        <p class="section__desc">Chúng tôi hợp tác với hơn 50 bể bơi lớn, khang trang và sạch sẽ trên toàn thành phố để mang lại sự tiện lợi tối đa cho bạn.</p>
      </div>

      <div class="hanoi-pools-grid reveal">
        {pools.map((pool) => (
          <div class="pool-card">
            <div class="pool-card__header">
              <span class="pool-card__icon">🏊</span>
              <span class="pool-card__badge">{pool.badge}</span>
            </div>
            <div class="pool-card__body">
              <h3 class="pool-card__title">{pool.name}</h3>
              <p class="pool-card__detail"><strong>📍 Địa chỉ:</strong> {pool.address}</p>
              <p class="pool-card__detail"><strong>🎨 Loại bể:</strong> {pool.type}</p>
              <div class="pool-card__pros">
                <strong>⭐ Điểm nổi bật:</strong>
                <span>{pool.pros}</span>
              </div>
            </div>
            <div class="pool-card__footer">
              <a href="https://zalo.me/0979121097" target="_blank" rel="noopener noreferrer" class="pool-card__btn">
                Đăng ký học tại đây →
              </a>
            </div>
          </div>
        ))}

        <!-- Custom Request Pool Card -->
        <div class="pool-card pool-card--request">
          <div class="pool-card__request-content">
            <span class="request-icon">❓</span>
            <h3 class="pool-card__title">Bạn muốn học bể bơi khác?</h3>
            <p class="pool-card__request-desc">Nếu bạn đã có bể bơi ở chung cư hoặc muốn học tại bể bơi gần nhà mình, HLV Swim For Life sẽ di chuyển tới tận nơi để giảng dạy.</p>
            <a href="tel:0979121097" class="btn btn--accent btn--sm">
              📞 Gọi 0979.121.097
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       COURSE PROGRAMS GRID
       ============================================ -->
  <section class="section section--alt hanoi-programs-section">
    <div class="container container--wide">
      <div class="section__header text-center reveal">
        <span class="section__badge">Chương Trình Đào Tạo</span>
        <h2 class="section__title">Các Khóa Học Bơi <span class="text-gradient">Phổ Biến Tại Hà Nội</span></h2>
        <p class="section__desc">Lựa chọn chương trình học phù hợp với nhu cầu và lứa tuổi của bạn. Cam kết đầu ra biết bơi thành thạo.</p>
      </div>

      <div class="hanoi-programs-grid reveal">
        <!-- Program 1 -->
        <div class="program-card">
          <div class="program-card__img-wrap">
            <img src="/images/classes/lop-boi-tre-em-bai-ban.jpg" alt="Học bơi trẻ em Hà Nội" />
            <span class="program-card__tag">Dành cho trẻ em</span>
          </div>
          <div class="program-card__body">
            <h3 class="program-card__title">Khóa Học Bơi Trẻ Em</h3>
            <p class="program-card__desc">Giáo trình chuyên biệt thiết kế riêng cho trẻ em từ 5-15 tuổi. Tập trung rèn luyện phản xạ an toàn dưới nước, học kỹ thuật bơi Ếch, bơi Sải và kỹ năng tự cứu mình khi gặp sự cố đuối nước.</p>
            <ul class="program-card__list">
              <li>⏱️ Số buổi: 10 - 12 buổi (60 phút/buổi)</li>
              <li>👨 HLV kèm sát sao dưới nước</li>
              <li>🛡️ Học thử 1 buổi miễn phí</li>
            </ul>
          </div>
          <div class="program-card__footer">
            <a href="https://zalo.me/0979121097" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--full">Đăng Ký Khóa Trẻ Em</a>
          </div>
        </div>

        <!-- Program 2 -->
        <div class="program-card">
          <div class="program-card__img-wrap">
            <img src="/images/classes/hoc-vien-chinh-sua-trong-nuoc.jpg" alt="Học bơi người lớn Hà Nội" />
            <span class="program-card__tag program-card__tag--orange">Dành cho người lớn</span>
          </div>
          <div class="program-card__body">
            <h3 class="program-card__title">Khóa Học Bơi Người Lớn</h3>
