---
import PageLayout from '../layouts/PageLayout.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
import LocalDirectoryCTA from '../components/LocalDirectoryCTA.astro';

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Hợp tác đào tạo' },
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Yêu cầu hợp tác đào tạo bơi quy mô lớn',
  description: 'Biểu mẫu dành cho doanh nghiệp, trường học, khu dân cư và đoàn thể cần triển khai chương trình bơi lội từ 10 người.',
  url: 'https://dayboi.vip/lien-he/',
};
---

<PageLayout
  title="Hợp Tác Đào Tạo Bơi Cho Doanh Nghiệp & Tổ Chức"
  description="Gửi yêu cầu xây dựng chương trình đào tạo bơi quy mô lớn cho doanh nghiệp, trường học, khu dân cư và đoàn thể từ 10 người."
  canonical="https://dayboi.vip/lien-he/"
  breadcrumbs={breadcrumbs}
  schema={contactSchema}
  alternateUrl="/en/contact/"
  alternateLang="en"
>
  <main class="enterprise-contact">
    <section class="enterprise-contact__hero">
      <div class="container enterprise-contact__hero-grid">
        <div>
          <span>Đào tạo theo đoàn từ 10 người</span>
          <h1>Thiết kế chương trình bơi cho <em>tổ chức của bạn</em></h1>
          <p>Swim For Life chỉ tiếp nhận yêu cầu từ doanh nghiệp, trường học, khu dân cư và đoàn thể cần triển khai đào tạo bơi hoặc an toàn nước ở quy mô lớn.</p>
          <ul>
            <li>Khảo sát đối tượng, địa điểm và rủi ro trước khi lập kế hoạch</li>
            <li>Bố trí đội ngũ HLV, cứu hộ và tỷ lệ giám sát theo quy mô</li>
            <li>Đề xuất lộ trình, tiến độ và tiêu chí đánh giá đầu ra</li>
          </ul>
        </div>
        <img src="/images/classes/to-chuc-tap-luyen-bai-ban-chuyen-nghiep.jpg" alt="Chương trình huấn luyện bơi theo nhóm được tổ chức bài bản" width="720" height="540" loading="eager" />
      </div>
    </section>

    <section class="section" id="yeu-cau-hop-tac">
      <div class="container enterprise-contact__form-grid">
        <div>
          <span class="section__badge">Yêu cầu đề xuất</span>
          <h2 class="section__title">Cho chúng tôi biết phạm vi triển khai</h2>
          <p class="section__desc">Thông tin càng cụ thể, đội ngũ càng dễ đánh giá tính khả thi và chuẩn bị phương án phù hợp trước khi phản hồi.</p>
          <div class="enterprise-contact__criteria">
            <div><strong>Đối tượng phù hợp</strong><p>Doanh nghiệp, trường học, ban quản lý khu dân cư, tổ chức xã hội hoặc đoàn từ 10 người.</p></div>
            <div><strong>Không tiếp nhận</strong><p>Đăng ký học cá nhân, học thử 1 kèm 1 hoặc yêu cầu ghép lớp lẻ.</p></div>
          </div>
        </div>
        <RegistrationForm id="enterprise-contact-form" flat={true} />
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <LocalDirectoryCTA />
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .enterprise-contact__hero { position: relative; overflow: hidden; padding: clamp(4rem, 8vw, 7.5rem) 0; background: var(--blue-950); color: var(--white); }
  .enterprise-contact__hero::before { content: ''; position: absolute; inset: 0; opacity: .14; background-image: linear-gradient(color-mix(in srgb, var(--white) 12%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--white) 12%, transparent) 1px, transparent 1px); background-size: 72px 72px; }
  .enterprise-contact__hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(420px, .9fr); align-items: center; gap: clamp(3rem, 7vw, 7rem); }
  .enterprise-contact__hero span { color: var(--blue-200); font-size: .74rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .enterprise-contact__hero h1 { margin: var(--space-4) 0 0; color: var(--white); font-size: clamp(2.8rem, 5.8vw, 5.8rem); line-height: 1; letter-spacing: -.06em; }
  .enterprise-contact__hero h1 em { color: var(--orange-400); font-style: normal; }
  .enterprise-contact__hero p { margin: var(--space-6) 0 0; color: color-mix(in srgb, var(--white) 72%, transparent); font-size: var(--text-lg); line-height: 1.75; }
  .enterprise-contact__hero ul { display: grid; gap: var(--space-3); margin: var(--space-6) 0 0; padding: 0; list-style: none; }
  .enterprise-contact__hero li { display: flex; gap: var(--space-3); color: color-mix(in srgb, var(--white) 82%, transparent); }
  .enterprise-contact__hero li::before { content: ''; width: 8px; height: 8px; flex: 0 0 auto; margin-top: .55em; border-radius: 50%; background: var(--orange-400); }
  .enterprise-contact__hero img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-xl); }
  .enterprise-contact__form-grid { display: grid; grid-template-columns: minmax(280px, .72fr) minmax(0, 1.28fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .enterprise-contact__criteria { display: grid; gap: var(--space-4); margin-top: var(--space-8); }
  .enterprise-contact__criteria div { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--sand-50); }
  .enterprise-contact__criteria strong { color: var(--blue-900); }
  .enterprise-contact__criteria p { margin: var(--space-2) 0 0; color: var(--ink-600); font-size: .86rem; line-height: 1.6; }
  @media (max-width: 900px) { .enterprise-contact__hero-grid, .enterprise-contact__form-grid { grid-template-columns: 1fr; } .enterprise-contact__hero img { max-width: 680px; } }
</style>
