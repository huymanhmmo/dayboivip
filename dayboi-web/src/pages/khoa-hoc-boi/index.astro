---
const currentYear = new Date().getFullYear();
import PageLayout from '../../layouts/PageLayout.astro';
import CourseHero from '../../components/course/CourseHero.astro';
import CourseTrust from '../../components/course/CourseTrust.astro';
import CourseFAQ from '../../components/course/CourseFAQ.astro';
import LocalDirectoryCTA from '../../components/LocalDirectoryCTA.astro';
import { courses } from '../../data/courses.js';
import CoachesSection from '../../components/CoachesSection.astro';
import '../../styles/course-landing.css';

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Khóa học bơi' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Khóa học bơi theo độ tuổi và mục tiêu",
  "description": "Trang tổng hợp chương trình học bơi cho trẻ em, người lớn, người sợ nước, nhóm và tổ chức.",
  "url": "https://dayboi.vip/khoa-hoc-boi/",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": courses.length,
    "itemListElement": courses.map((course, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": course.shortTitle,
      "url": `https://dayboi.vip/khoa-hoc-boi/${course.slug}/`
    }))
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Khóa học bơi Swim For Life kéo dài bao lâu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Thời lượng phụ thuộc trình độ đầu vào, mục tiêu và tần suất tập. Hãy hỏi đơn vị tổ chức về số buổi, thời lượng mỗi buổi và tiêu chí đánh giá đầu ra trước khi đăng ký."
      }
    },
    {
      "@type": "Question",
      "name": "Swim For Life có những loại khóa học nào?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Website có nội dung tham khảo cho trẻ em, người lớn, người sợ nước, lớp kèm riêng, nhóm nhỏ và chương trình cho tổ chức."
      }
    },
    {
      "@type": "Question",
      "name": "Học phí khóa bơi tại Swim For Life là bao nhiêu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Học phí thay đổi theo địa điểm, vé bể, sĩ số và số buổi. Người học cá nhân nên hỏi trực tiếp đơn vị trong danh bạ; tổ chức nhận báo giá theo quy mô và yêu cầu triển khai."
      }
    },
    {
      "@type": "Question",
      "name": "Swim For Life dạy những kỹ thuật bơi nào?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nội dung kỹ thuật gồm bơi ếch, bơi sải, bơi ngửa, bơi bướm và kỹ năng đứng nước. Người mới nên bắt đầu bằng thở, nổi và lướt nước."
      }
    },
    {
      "@type": "Question",
      "name": "Swim For Life có tiếp nhận học viên cá nhân không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Không. Người học cá nhân được hướng dẫn dùng danh bạ địa phương để tự liên hệ bể bơi, câu lạc bộ hoặc giáo viên độc lập. Swim For Life chỉ tiếp nhận chương trình cho tổ chức và đoàn từ 10 người."
      }
    }
  ]
};

const combinedSchema = [schema, faqSchema];

const hubHeroStats = [
  { number: courses.length, suffix: '', label: 'Chương trình tham khảo' },
  { number: 4, suffix: '', label: 'Kiểu bơi phổ biến' },
  { number: 34, suffix: '', label: 'Tỉnh, thành trong danh bạ' }
];

const faqs = [
  {
    question: "Khóa học bơi Swim For Life kéo dài bao lâu?",
    answer: "Thời lượng phụ thuộc trình độ đầu vào, mục tiêu và tần suất tập. Hãy hỏi đơn vị tổ chức về số buổi, thời lượng mỗi buổi và tiêu chí đánh giá đầu ra trước khi đăng ký."
  },
  {
    question: "Swim For Life có những loại khóa học nào?",
    answer: "Các nội dung cá nhân trên website được giữ lại như tài liệu tham khảo. Swim For Life hiện chỉ tiếp nhận chương trình doanh nghiệp, trường học, khu dân cư và tổ chức có quy mô từ 10 người."
  },
  {
    question: "Học phí khóa bơi tại Swim For Life là bao nhiêu?",
    answer: "Người học cá nhân cần hỏi giá trực tiếp từ đơn vị trong danh bạ địa phương. Chương trình tổ chức được báo giá riêng theo số người, địa điểm, thời lượng và yêu cầu an toàn."
  },
  {
    question: "Swim For Life dạy những kỹ thuật bơi nào?",
    answer: "Nội dung kỹ thuật gồm bơi ếch, bơi sải, bơi ngửa, bơi bướm và kỹ năng đứng nước. Người mới nên bắt đầu bằng thở, nổi và lướt nước."
  },
  {
    question: "Swim For Life có tiếp nhận học viên cá nhân không?",
    answer: "Không. Người học cá nhân dùng danh bạ địa phương để tự liên hệ đơn vị phù hợp. Swim For Life chỉ tiếp nhận chương trình cho tổ chức và đoàn từ 10 người."
  },
];
---

<PageLayout
  title="Khóa Học Bơi Cho Trẻ Em & Người Lớn | Swim For Life"
  description="Tìm hiểu khóa học bơi theo độ tuổi và mục tiêu. Người học cá nhân tra cứu lớp gần nhà; trường học, doanh nghiệp và khu dân cư có thể yêu cầu chương trình riêng."
  canonical="https://dayboi.vip/khoa-hoc-boi/"
  breadcrumbs={breadcrumbs}
  schema={combinedSchema}
>
  <div class="course-landing">
    <!-- Hero Section -->
    <CourseHero 
      title="Khóa học bơi cho trẻ em, người lớn và tổ chức"
      subtitle="Chọn nội dung theo độ tuổi, trình độ và mục tiêu. Người học cá nhân có thể tìm lớp gần nhà; tổ chức từ 10 người được tư vấn chương trình riêng."
      description="Chọn nội dung theo độ tuổi, trình độ và mục tiêu. Người học cá nhân có thể tìm lớp gần nhà; tổ chức từ 10 người được tư vấn chương trình riêng."
      image="/images/classes/giang-vien-huong-dan-ky-thuat.jpg"
      stats={hubHeroStats}
      slug="hub"
    />

    <!-- Course Grid Section -->
    <section class="cl-section" id="khoa-hoc">
      <div class="cl-section__container">
        <div class="cl-section-title">
          <span class="cl-section-title__badge">
            Chương Trình Tham Khảo
          </span>
          <h2 class="cl-section-title__heading">
            Chọn khóa học bơi theo nhu cầu
          </h2>
          <p class="cl-section-title__sub">
            Xem nội dung dành cho trẻ em, người lớn, người sợ nước, nhóm nhỏ và tổ chức trước khi chọn nơi học.
          </p>
          <span class="cl-section-title__decoration"></span>
        </div>

        <div class="cl-course-grid">
          {courses.map((course) => (
            <div class="cl-hub-card cl-animate">
              <div class="cl-hub-card__image-wrapper">
                <img src={course.heroImage} alt={course.title} class="cl-hub-card__image" loading="lazy" width="640" height="360" />
                <span class="cl-hub-card__badge">{course.targetAudience}</span>
              </div>
              <div class="cl-hub-card__content">
                <div class="cl-hub-card__icon-title">
                  <span class="cl-hub-card__icon">{course.icon}</span>
                  <h3 class="cl-hub-card__title">{course.shortTitle}</h3>
                </div>
                <p class="cl-hub-card__description">
                  {course.subtitle}
                </p>
                <div class="cl-hub-card__specs">
                  <div class="cl-hub-card__spec">
                    <span class="cl-hub-card__spec-icon">⏱️</span>
                    <span>{course.duration}</span>
                  </div>
                  <div class="cl-hub-card__spec">
                    <span class="cl-hub-card__spec-icon">👥</span>
                    <span>{course.classSize}</span>
                  </div>
                </div>
                <div class="cl-hub-card__footer">
                  <div class="cl-hub-card__price-wrapper">
                    <span class="cl-hub-card__price-label">Nội dung</span>
                    <span class="cl-hub-card__price">Tham khảo</span>
                  </div>
                  <a href={`/khoa-hoc-boi/${course.slug}/`} class="cl-hub-card__btn">
                    Xem chi tiết →
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compare Section -->
    <section class="cl-section cl-section--alt" id="so-sanh">
      <div class="cl-section__container">
        <div class="cl-section-title">
          <span class="cl-section-title__badge">
            Lựa Chọn Phù Hợp
          </span>
          <h2 class="cl-section-title__heading">
            So Sánh Các Hình Thức Học Bơi
          </h2>
          <p class="cl-section-title__sub">
            So sánh sĩ số, cách tổ chức và mức độ linh hoạt để chọn hình thức phù hợp với người học.
          </p>
          <span class="cl-section-title__decoration"></span>
        </div>

        <div class="cl-comparison-table-wrapper cl-animate">
          <table class="cl-comparison-table">
            <thead>
              <tr>
                <th>Tiêu chí</th>
                <th>Khóa Cá Nhân 1 Kèm 1</th>
                <th>Khóa Nhóm 3 - 5 Bé</th>
                <th>Doanh Nghiệp & Đoàn Thể</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Số học viên / HLV</strong></td>
                <td>1 học viên / 1 thầy</td>
                <td>3 - 5 học viên / 1 thầy</td>
                <td>Số lượng lớn (HLV tương ứng)</td>
              </tr>
              <tr>
                <td><strong>Giáo trình học</strong></td>
                <td>Cá nhân hóa theo thể trạng & tâm lý</td>
                <td>Giáo trình chuẩn, thi đua cùng bạn bè</td>
                <td>Thiết kế riêng theo nhu cầu doanh nghiệp</td>
              </tr>
              <tr>
                <td><strong>Địa điểm học</strong></td>
                <td>Tự chọn bể bơi gần nhà / bể bơi gia đình</td>
                <td>Hệ thống bể bơi bốn mùa liên kết</td>
                <td>Gần văn phòng hoặc tại cơ sở liên kết</td>
              </tr>
              <tr>
                <td><strong>Lịch học</strong></td>
                <td>Linh hoạt 100% theo học viên</td>
                <td>Cố định theo ca chọn khi đăng ký</td>
                <td>Theo thỏa thuận, linh hoạt ca kíp</td>
              </tr>
              <tr>
                <td><strong>Cam kết đầu ra</strong></td>
                <td>Biết bơi 100% (học tiếp miễn phí)</td>
                <td>Tỉ lệ biết bơi trên 98%</td>
                <td>Cam kết theo hợp đồng dịch vụ</td>
              </tr>
              <tr>
                <td><strong>Thời gian trung bình</strong></td>
                <td>7 - 10 buổi biết bơi</td>
                <td>10 - 12 buổi biết bơi</td>
                <td>10 - 12 buổi biết bơi</td>
              </tr>
              <tr>
                <td><strong>Mức học phí</strong></td>
                <td>Cao (Đáng giá từng đồng)</td>
                <td>Tiết kiệm, ưu đãi theo nhóm</td>
                <td>Mức chiết khấu cao cho số lượng lớn</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Trust & Quality Guarantee Badges -->
    <CourseTrust />

    <!-- FAQ Accordion -->
    <CourseFAQ 
      faqs={faqs}
    />

    <CoachesSection />

    <LocalDirectoryCTA />
  </div>
</PageLayout>

<style>
  .cl-course-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: 48px;
  }
  
  @media (min-width: 768px) {
    .cl-course-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .cl-course-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .cl-hub-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(10, 77, 140, 0.05);
    border: 1px solid rgba(10, 77, 140, 0.08);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .cl-hub-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 36px rgba(10, 77, 140, 0.12);
    border-color: var(--cl-primary-light);
  }
  
  .cl-hub-card__image-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
  }
  
  .cl-hub-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .cl-hub-card:hover .cl-hub-card__image {
    transform: scale(1.08);
  }
  
  .cl-hub-card__badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(10, 77, 140, 0.9);
    color: #fff;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }
  
  .cl-hub-card__content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .cl-hub-card__icon-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  
  .cl-hub-card__icon {
    font-size: 1.5rem;
  }
  
  .cl-hub-card__title {
    font-family: var(--cl-font);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cl-dark);
    margin: 0;
    line-height: 1.4;
  }
  
  .cl-hub-card__description {
    font-size: 0.9rem;
    color: var(--cl-text-light);
    line-height: 1.6;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }
  
  .cl-hub-card__specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 24px;
    padding-top: 16px;
    border-top: 1px dashed rgba(10, 77, 140, 0.1);
  }
  
  .cl-hub-card__spec {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--cl-text);
  }
  
  .cl-hub-card__spec-icon {
    color: var(--cl-primary-light);
    font-size: 1rem;
  }
  
  .cl-hub-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid rgba(10, 77, 140, 0.08);
  }
  
  .cl-hub-card__price-wrapper {
    display: flex;
    flex-direction: column;
  }
  
  .cl-hub-card__price-label {
    font-size: 0.75rem;
    color: var(--cl-text-light);
  }
  
  .cl-hub-card__price {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--cl-primary);
  }
  
  .cl-hub-card__btn {
    padding: 8px 16px;
    background: var(--cl-cta-gradient);
    color: #fff !important;
    font-weight: 600;
    font-size: 0.85rem;
    border-radius: 30px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(255, 107, 107, 0.2);
    transition: all 0.3s ease;
  }
  
  .cl-hub-card__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 107, 107, 0.3);
  }
  
  /* Comparison Table section styling */
  .cl-comparison-table-wrapper {
    overflow-x: auto;
    background: #fff;
    border-radius: 16px;
    box-shadow: var(--cl-shadow-md);
    border: 1px solid rgba(10, 77, 140, 0.08);
    margin-top: 32px;
  }
  
  .cl-comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 800px;
  }
  
  .cl-comparison-table th, 
  .cl-comparison-table td {
    padding: 16px 24px;
    border-bottom: 1px solid rgba(10, 77, 140, 0.08);
    font-size: 0.95rem;
  }
  
  .cl-comparison-table th {
    background: rgba(10, 77, 140, 0.03);
    color: var(--cl-primary);
    font-weight: 700;
    font-family: var(--cl-font);
  }
  
  .cl-comparison-table tr:last-child td {
    border-bottom: none;
  }
  
  .cl-comparison-table tr:hover {
    background: rgba(10, 77, 140, 0.01);
  }
</style>

<script>
  // Intersection Observer for scroll animations (.cl-animate)
  const setupAnimations = () => {
    const animElements = document.querySelectorAll('.course-landing .cl-animate');
    
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -50px 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('cl-visible');
          // Once animated, we don't need to observe it anymore
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    animElements.forEach(el => observer.observe(el));
  };

  // Stats counter animation (data-counter)
  const setupCounters = () => {
    const counterElements = document.querySelectorAll('.course-landing [data-counter]');

    const animateCounter = (el: HTMLElement) => {
      const target = parseInt(el.getAttribute('data-target') || '0', 10);
      const suffix = el.getAttribute('data-suffix') || '';
      const duration = 2000; // 2 seconds
      const startTime = performance.now();

      const updateCount = (currentTime: number) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        
        // Easing function (easeOutQuad)
        const easeProgress = progress * (2 - progress);
        
        const currentValue = Math.floor(easeProgress * target);
        
        // Format with thousand separator for VN locale
        el.textContent = currentValue.toLocaleString('vi-VN') + suffix;

        if (progress < 1) {
          requestAnimationFrame(updateCount);
        } else {
          el.textContent = target.toLocaleString('vi-VN') + suffix;
        }
      };

      requestAnimationFrame(updateCount);
    };

    const observerOptions = {
      root: null,
      threshold: 0.2
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          if (!el.classList.contains('counted')) {
            el.classList.add('counted');
            animateCounter(el);
          }
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    counterElements.forEach(el => observer.observe(el));
  };

  // Run on page load
  document.addEventListener('DOMContentLoaded', () => {
    setupAnimations();
    setupCounters();
  });

  // Execute immediately in case DOMContentLoaded has already fired
  setupAnimations();
  setupCounters();
</script>

