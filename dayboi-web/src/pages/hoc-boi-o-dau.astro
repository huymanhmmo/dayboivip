---
import PageLayout from '../layouts/PageLayout.astro';
import { locations } from '../data/locations.js';
import { countReviewedVenues } from '../data/locationResearch.js';
import { publishedLocationAreas } from '../data/locationAreas.js';
import '../styles/location-directory.css';

const regions = [...new Set(locations.map((location) => location.region))];
const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Địa điểm' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Danh bạ bể bơi và nơi dạy bơi trên toàn quốc',
  description: 'Danh bạ giúp người học chủ động tra cứu và liên hệ trực tiếp với bể bơi, câu lạc bộ và đơn vị dạy bơi tại địa phương.',
  url: 'https://dayboi.vip/hoc-boi-o-dau/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: locations.length + publishedLocationAreas.length,
    itemListElement: [...locations.map((location) => ({
      name: `Danh bạ bơi lội ${location.name}`,
      url: `https://dayboi.vip/${location.slug}/`,
    })), ...publishedLocationAreas.map((area) => ({
      name: `Học bơi tại ${area.name}, ${area.parentName}`,
      url: `https://dayboi.vip${area.url}`,
    }))].map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      ...item,
    })),
  },
};
---

<PageLayout
  title="Danh Bạ Bể Bơi, CLB & Giáo Viên Dạy Bơi Toàn Quốc"
  description="Chọn tỉnh thành để tra cứu bể bơi, câu lạc bộ và giáo viên dạy bơi có thông tin công khai. Người học liên hệ trực tiếp với đơn vị địa phương."
  canonical="https://dayboi.vip/hoc-boi-o-dau/"
  image="/images/classes/lop-hoc-boi-ha-noi.jpg"
  type="website"
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <div class="directory-hub">
    <section class="directory-hub__hero">
      <div class="container directory-hub__hero-grid">
        <div>
          <span class="local-directory__eyebrow">34 tỉnh, thành · {publishedLocationAreas.length} khu vực có trang chi tiết</span>
          <h1>Tìm nơi học bơi <span>gần bạn</span></h1>
          <p>Chọn tỉnh, thành hoặc quận huyện để xem bể bơi, lớp học và đầu mối dạy bơi gần nơi bạn sống. Hãy kiểm tra lịch học, học phí và điều kiện vào bể trực tiếp với đơn vị trước khi đăng ký.</p>
          <label class="directory-hub__search">
            <span class="sr-only">Tìm tỉnh hoặc thành phố</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
            <input type="search" id="directory-search" placeholder="Nhập tỉnh hoặc thành phố…" autocomplete="off" />
          </label>
        </div>
        <figure>
          <img src="/images/classes/lop-hoc-boi-ha-noi.jpg" alt="Lớp bơi thực tế với huấn luyện viên hướng dẫn dưới nước" width="700" height="520" loading="eager" />
          <figcaption>Tham khảo địa điểm trước, sau đó trao đổi trực tiếp với đơn vị tổ chức lớp.</figcaption>
        </figure>
      </div>
    </section>

    <section class="directory-hub__principles">
      <div class="container">
        <div><strong>Không thu phí giới thiệu</strong><span>Website không nhận hoa hồng từ đơn vị được liệt kê.</span></div>
        <div><strong>Liên hệ trực tiếp</strong><span>Người học tự trao đổi với bể bơi, CLB hoặc giáo viên địa phương.</span></div>
        <div><strong>Luôn cần xác minh</strong><span>Kiểm tra giờ mở cửa, giá, chứng chỉ và đánh giá mới nhất trước khi học.</span></div>
      </div>
    </section>

    <section class="section" aria-labelledby="directory-title">
      <div class="container">
        <div class="section__header">
          <span class="section__badge">Chọn địa phương</span>
          <h2 class="section__title" id="directory-title">Danh bạ bơi lội toàn quốc</h2>
          <p class="section__desc">Nhập tên địa phương vào ô tìm kiếm hoặc chọn một khu vực bên dưới để bắt đầu.</p>
        </div>
        <p class="directory-hub__empty" id="directory-empty" hidden>Không tìm thấy địa phương phù hợp. Hãy thử tên tỉnh/thành khác.</p>
        <div class="directory-hub__regions" id="directory-regions">
          <section class="directory-hub__region" data-region="Khu vực có thông tin chi tiết">
            <div class="directory-hub__region-heading">
              <span>{String(publishedLocationAreas.length).padStart(2, '0')}</span>
              <h3>Khu vực có thông tin chi tiết</h3>
            </div>
            <div class="directory-hub__grid">
              {publishedLocationAreas.map((area) => (
                <a href={area.url} class="directory-hub__card" data-location={`${area.name} ${area.nearbyAreas.join(' ')}`.toLowerCase()}>
                  <img src={area.parentImage} alt={`Học bơi tại ${area.seoPlace}`} width="320" height="210" loading="lazy" />
                  <div>
                    <span>{area.category.venues.length} địa điểm tham khảo</span>
                    <h4>{area.name}, {area.parentName}</h4>
                    <p>{area.nearbyAreas.join(' · ')}</p>
                    <strong>Xem lớp học & bể bơi <b>→</b></strong>
                  </div>
                </a>
              ))}
            </div>
          </section>
          {regions.map((region) => (
            <section class="directory-hub__region" data-region={region}>
              <div class="directory-hub__region-heading">
                <span>{String(locations.filter((location) => location.region === region).length).padStart(2, '0')}</span>
                <h3>{region}</h3>
              </div>
              <div class="directory-hub__grid">
                {locations.filter((location) => location.region === region).map((location) => (
                  <a href={`/${location.slug}/`} class="directory-hub__card" data-location={`${location.name} ${location.mergedFrom || ''}`.toLowerCase()}>
                    <img src={location.image} alt={`Địa điểm học bơi tại ${location.name}`} width="320" height="210" loading="lazy" />
                    <div>
                      <span>{countReviewedVenues(location.slug) ? `${countReviewedVenues(location.slug)} địa điểm tham khảo` : `${location.pools.length} địa điểm đang cập nhật`}</span>
                      <h4>{location.name}</h4>
                      {location.mergedFrom && <p>Khu vực: {location.mergedFrom}</p>}
                      <strong>Xem bể bơi, CLB & HLV <b>→</b></strong>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--alt directory-hub__roadmap" aria-labelledby="roadmap-title">
      <div class="container">
        <div class="section__header">
          <span class="section__badge">Trước khi đăng ký</span>
          <h2 class="section__title" id="roadmap-title">Ba bước chọn nơi học bơi phù hợp</h2>
          <p class="section__desc">Đừng chỉ chọn theo quảng cáo. Một vài câu hỏi ngắn sẽ giúp bạn tránh đi xa, phát sinh chi phí hoặc vào nhầm lớp.</p>
        </div>
        <div class="directory-hub__roadmap-grid">
          <article>
            <div><span>01</span><strong>Khoảng cách</strong></div>
            <h3>Chọn bể thuận đường đi</h3>
            <p>Ưu tiên địa điểm gần nhà, trường học hoặc nơi làm việc để duy trì lịch học đều.</p>
            <small>Kiểm tra chỗ gửi xe, giờ cao điểm và thời gian di chuyển.</small>
          </article>
          <article>
            <div><span>02</span><strong>Lớp học</strong></div>
            <h3>Hỏi rõ đối tượng và sĩ số</h3>
            <p>Xác nhận độ tuổi, trình độ đầu vào, số học viên mỗi giáo viên và cách học bù.</p>
            <small>Người sợ nước hoặc trẻ nhỏ thường cần lớp ít người hơn.</small>
          </article>
          <article>
            <div><span>03</span><strong>Chi phí</strong></div>
            <h3>Chốt tổng phí trước khi học</h3>
            <p>Hỏi học phí đã gồm vé bể, dụng cụ, buổi kiểm tra đầu vào và phí học bù hay chưa.</p>
            <small>Nên nhận thông tin bằng tin nhắn để dễ đối chiếu.</small>
          </article>
        </div>
      </div>
    </section>

    <section class="local-directory__enterprise">
      <div class="container local-directory__enterprise-inner">
        <div>
          <span>Doanh nghiệp · trường học · khu dân cư</span>
          <h2>Cần một chương trình đào tạo quy mô lớn?</h2>
          <p>Swim For Life chỉ tiếp nhận yêu cầu đào tạo theo đoàn từ 10 người, có kế hoạch an toàn, nhân sự và tiến độ triển khai rõ ràng.</p>
        </div>
        <a href="/khoa-hoc-boi/doanh-nghiep/">Gửi yêu cầu cho tổ chức</a>
      </div>
    </section>
  </div>
</PageLayout>

<script>
  const setupDirectorySearch = () => {
    const input = document.querySelector<HTMLInputElement>('#directory-search');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-location]')];
    const regions = [...document.querySelectorAll<HTMLElement>('[data-region]')];
    const empty = document.querySelector<HTMLElement>('#directory-empty');
    if (!input || input.dataset.bound === 'true') return;
    input.dataset.bound = 'true';
    input.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase('vi');
      let visible = 0;
      cards.forEach((card) => {
        const show = !query || (card.dataset.location || '').includes(query);
        card.hidden = !show;
        if (show) visible += 1;
      });
      regions.forEach((region) => {
        region.hidden = !region.querySelector('[data-location]:not([hidden])');
      });
      if (empty) empty.hidden = visible > 0;
    });
  };
  document.addEventListener('DOMContentLoaded', setupDirectorySearch);
  document.addEventListener('astro:page-load', setupDirectorySearch);
  setupDirectorySearch();
</script>
