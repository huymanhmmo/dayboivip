---
import RegionDirectoryPage from '../../components/locality/RegionDirectoryPage.astro';
import LocalLandingPage from '../../components/landing/LocalLandingPage.astro';
import {laiThieuLanding} from '../../data/localLandingPages';
import {areaPaths,buildAreaPage} from '../../data/locality/area';
export function getStaticPaths(){return areaPaths('vi');}
const {commune,isCommune}=Astro.props;
const isLaiThieu=isCommune&&commune.parentSlug==='hoc-boi-tphcm'&&commune.slug==='lai-thieu';
const page=isLaiThieu?null:buildAreaPage(Astro.props,'vi');
---
{isLaiThieu?<LocalLandingPage data={laiThieuLanding} />:<RegionDirectoryPage page={page!} />}
