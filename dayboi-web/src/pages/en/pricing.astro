---
import PageLayout from '../../layouts/PageLayout.astro';
import LocalDirectoryCTA from '../../components/LocalDirectoryCTA.astro';

const currentYear = new Date().getFullYear();
const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Costs & proposals' },
];
---

<PageLayout
  title={`Swimming Lesson Costs & Organization Proposals ${currentYear}`}
  description="Individuals can compare local providers and contact them directly. Companies, schools, and groups of 10 or more can request a tailored program proposal."
  canonical="https://dayboi.vip/en/pricing/"
  breadcrumbs={breadcrumbs}
  lang="en"
  alternateUrl="/bang-gia/"
  alternateLang="vi"
>
  <main class="pricing-router">
    <section class="pricing-router__hero">
      <div class="container pricing-router__hero-grid">
        <div>
          <span>Two needs · two paths</span>
          <h1>Swimming costs depend on the <em>provider</em> and program scale</h1>
          <p>Swim For Life does not accept individual lesson registrations or publish prices on behalf of independent pools and instructors. Individuals contact local providers directly; organizations with 10 or more participants receive a tailored proposal.</p>
        </div>
        <img src="/images/classes/to-chuc-tap-luyen-bai-ban-chuyen-nghiep.jpg" alt="A structured group swimming lesson" width="720" height="540" loading="eager" />
      </div>
    </section>

    <section class="section">
      <div class="container pricing-router__paths">
        <article>
          <span>01 · Individuals and families</span>
          <h2>Ask local providers directly</h2>
          <p>Fees vary by pool admission, private or group format, session count, and coach experience. The directory opens public listings so you can verify and contact each provider.</p>
          <ul>
            <li>Ask whether pool admission and equipment are included</li>
            <li>Confirm class size, duration, make-up lessons, and refunds</li>
            <li>Verify coach credentials and on-duty lifeguards</li>
          </ul>
          <a href="/hoc-boi-o-dau/">Open local directory <b>→</b></a>
        </article>
        <article class="pricing-router__paths-enterprise">
          <span>02 · Companies and organizations</span>
          <h2>Request a scoped proposal</h2>
          <p>Cost depends on participant count, ages, venue, duration, coaching and lifeguard requirements, and outcome criteria. Share your brief so the team can design a viable program.</p>
          <ul>
            <li>Designed for groups of 10 or more</li>
            <li>Suitable for companies, schools, and residential communities</li>
            <li>Roadmap and resources matched to actual scale</li>
          </ul>
          <a href="/en/contact/">Request a proposal <b>→</b></a>
        </article>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container"><LocalDirectoryCTA lang="en" /></div>
    </section>
  </main>
</PageLayout>

<style>
  .pricing-router__hero { padding: clamp(4rem, 8vw, 7.5rem) 0; background: var(--blue-950); color: var(--white); }
  .pricing-router__hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(390px, .85fr); gap: clamp(3rem, 7vw, 7rem); align-items: center; }
  .pricing-router__hero span, .pricing-router__paths article > span { color: var(--blue-200); font-size: .74rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .pricing-router__hero h1 { margin: var(--space-4) 0 0; color: var(--white); font-size: clamp(2.7rem, 5.7vw, 5.6rem); line-height: 1; letter-spacing: -.06em; }
  .pricing-router__hero h1 em { color: var(--orange-400); font-style: normal; }
  .pricing-router__hero p { margin: var(--space-6) 0 0; color: color-mix(in srgb, var(--white) 72%, transparent); font-size: var(--text-lg); line-height: 1.75; }
  .pricing-router__hero img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-xl); }
  .pricing-router__paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .pricing-router__paths article { display: flex; flex-direction: column; padding: clamp(2rem, 5vw, 4rem); border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--white); box-shadow: var(--shadow-md); }
  .pricing-router__paths article > span { color: var(--blue-700); }
  .pricing-router__paths h2 { margin: var(--space-4) 0 0; color: var(--blue-950); font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -.045em; }
  .pricing-router__paths p { color: var(--ink-600); line-height: 1.75; }
  .pricing-router__paths ul { display: grid; gap: var(--space-3); padding-left: 1.2rem; color: var(--ink-700); line-height: 1.55; }
  .pricing-router__paths a { display: inline-flex; align-items: center; justify-content: space-between; min-height: 54px; margin-top: auto; padding: 0 var(--space-5); border-radius: var(--radius-md); background: var(--blue-900); color: var(--white); font-weight: 750; }
  .pricing-router__paths-enterprise { background: var(--sand-50) !important; }
  .pricing-router__paths-enterprise a { background: var(--orange-500); }
  @media (max-width: 900px) { .pricing-router__hero-grid, .pricing-router__paths { grid-template-columns: 1fr; } .pricing-router__hero img { max-width: 680px; } }
</style>
