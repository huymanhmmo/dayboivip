---
import PageLayout from '../../layouts/PageLayout.astro';
import { locations } from '../../data/locations.js';
import '../../styles/location-directory.css';

export function getStaticPaths() {
  return locations.map((loc) => {
    let enSlug = loc.slug.replace('hoc-boi-', 'swimming-lessons-');
    if (loc.slug === 'hoc-boi-tphcm') enSlug = 'swimming-lessons-ho-chi-minh';
    return { params: { location: enSlug }, props: { loc, viSlug: loc.slug } };
  });
}

const { loc, viSlug } = Astro.props;
const currentYear = new Date().getFullYear();
const enNames = {
  'Hà Nội': 'Hanoi', 'TP. Hồ Chí Minh': 'Ho Chi Minh City', 'Đà Nẵng': 'Da Nang', 'Hải Phòng': 'Hai Phong',
  'Huế': 'Hue', 'Cần Thơ': 'Can Tho', 'Đồng Nai': 'Dong Nai', 'Quảng Ninh': 'Quang Ninh', 'Bắc Ninh': 'Bac Ninh',
  'Thái Nguyên': 'Thai Nguyen', 'Phu Thọ': 'Phu Tho', 'Ninh Bình': 'Ninh Binh', 'Hưng Yên': 'Hung Yen',
  'Thanh Hóa': 'Thanh Hoa', 'Nghệ An': 'Nghe An', 'Hà Tĩnh': 'Ha Tinh', 'Quảng Bình': 'Quang Binh',
  'Quảng Ngãi': 'Quang Ngai', 'Bình Định': 'Binh Dinh', 'Khánh Hòa': 'Khanh Hoa', 'Đắk Lắk': 'Dak Lak',
  'Lâm Đồng': 'Lam Dong', 'Tây Ninh': 'Tay Ninh', 'Đồng Tháp': 'Dong Thap', 'Vĩnh Long': 'Vinh Long',
  'An Giang': 'An Giang', 'Cà Mau': 'Ca Mau', 'Cao Bằng': 'Cao Bang', 'Lai Châu': 'Lai Chau',
  'Điện Biên': 'Dien Bien', 'Sơn La': 'Son La', 'Lạng Sơn': 'Lang Son', 'Lào Cai': 'Lao Cai', 'Tuyên Quang': 'Tuyen Quang',
};
const enName = enNames[loc.name] || loc.name;
const mapsSearch = (query) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const poolDirectory = loc.pools.map((pool) => ({ ...pool, mapsUrl: mapsSearch(`${pool.name}, ${pool.address || loc.name}`) }));
const discoveryLinks = [
  { label: 'All publicly listed swimming pools', desc: 'Review current opening hours, websites, and public contact details.', url: mapsSearch(`swimming pools in ${loc.name}`), icon: 'pool' },
  { label: 'Swimming instructors and providers', desc: 'Find instructors or centers publicly offering lessons in the area.', url: mapsSearch(`swimming instructors in ${loc.name}`), icon: 'coach' },
  { label: 'Swimming clubs', desc: 'Discover clubs, group classes, and locally operated programs.', url: mapsSearch(`swimming clubs in ${loc.name}`), icon: 'club' },
  { label: 'Public sports centers', desc: 'Find sports and cultural centers that may operate swimming facilities.', url: mapsSearch(`public sports center swimming pool ${loc.name}`), icon: 'public' },
];

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Local directory', href: '/hoc-boi-o-dau/' },
  { label: enName },
];

const directorySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Swimming pools and lesson providers in ${enName}`,
  description: `A reference directory of publicly listed pools, clubs, and tools for finding swimming instructors in ${enName}.`,
  url: `https://dayboi.vip/en/${Astro.params.location}/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: poolDirectory.length,
    itemListElement: poolDirectory.map((pool, index) => ({ '@type': 'ListItem', position: index + 1, name: pool.name, url: pool.mapsUrl })),
  },
};
---

<PageLayout
  title={`Swimming Pools & Lesson Providers in ${enName} [${currentYear}]`}
  description={`Find publicly listed swimming pools, clubs, and instructors in ${enName}. Verify current information and contact each local provider directly.`}
  canonical={`https://dayboi.vip/en/${Astro.params.location}/`}
  image={loc.image}
  type="website"
  breadcrumbs={breadcrumbs}
  schema={directorySchema}
  lang="en"
  alternateUrl={`/${viSlug}/`}
  alternateLang="vi"
>
  <main class="local-directory">
    <section class="local-directory__hero">
      <div class="container local-directory__hero-grid">
        <div>
          <span class="local-directory__eyebrow">Independent local directory</span>
          <h1>Pools & swimming providers in <span>{enName}</span></h1>
          <p>This page helps individual learners find and directly contact pools, clubs, or instructors with public listings in {enName}. Swim For Life does not take bookings, collect fees, or represent the listed providers.</p>
          <div class="local-directory__hero-actions">
            <a href="#directory-list">View starter list</a>
            <a href={mapsSearch(`swimming lessons in ${loc.name}`)} target="_blank" rel="noopener noreferrer">Search the live map</a>
          </div>
        </div>
        <figure>
          <img src={loc.image} alt={`Swimming activity in ${enName}`} width="680" height="510" loading="eager" />
          <figcaption>Illustrative image; it does not represent a specific facility.</figcaption>
        </figure>
      </div>
    </section>

    <section class="local-directory__notice">
      <div class="container">
        <strong>Check before contacting</strong>
        <p>Opening hours, fees, instructors, and phone numbers can change. Review the latest public listing and recent reviews, then confirm directly with the provider. This website does not endorse any third party.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="discovery-title">
      <div class="container">
        <div class="section__header">
          <span class="section__badge">Search by need</span>
          <h2 class="section__title" id="discovery-title">Find the right provider type in {enName}</h2>
          <p class="section__desc">These links open live map results so you can review public information and contact providers directly.</p>
        </div>
        <div class="local-directory__discovery-grid">
          {discoveryLinks.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="local-directory__discovery-card">
              <span class={`local-directory__icon local-directory__icon--${item.icon}`} aria-hidden="true"></span>
              <strong>{item.label}</strong><p>{item.desc}</p><span>View current results <b>↗</b></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--alt" id="directory-list" aria-labelledby="pool-list-title">
      <div class="container">
        <div class="section__header">
          <span class="section__badge">Starter list</span>
          <h2 class="section__title" id="pool-list-title">Frequently searched pools in {enName}</h2>
          <p class="section__desc">This is not an exhaustive market list. “Verify & contact” opens the current public listing so you can check whether the venue is operating.</p>
        </div>
        <div class="local-directory__pool-grid">
          {poolDirectory.map((pool, index) => (
            <article class="local-directory__pool-card">
              <div class="local-directory__pool-index">{String(index + 1).padStart(2, '0')}</div>
              <div>
                <span>{pool.type || 'Swimming pool'}</span><h3>{pool.name}</h3>
                {pool.address && <p><strong>Reference address:</strong> {pool.address}</p>}
                {pool.pros && <p><strong>Existing description:</strong> {pool.pros}</p>}
              </div>
              <a href={pool.mapsUrl} target="_blank" rel="noopener noreferrer">Verify & contact ↗</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="check-title">
      <div class="container local-directory__check-grid">
        <div><span class="section__badge">Evaluate before booking</span><h2 class="section__title" id="check-title">Five details to confirm</h2><p class="section__desc">Do not prepay for a long package until you have verified the provider and instructor.</p></div>
        <ol>
          <li><span>01</span><div><strong>Instructor identity and credentials</strong><p>Ask for relevant teaching and rescue certifications, plus experience with the learner's age group.</p></div></li>
          <li><span>02</span><div><strong>On-duty lifeguard</strong><p>Confirm lifeguard coverage, rescue equipment, and an emergency response process.</p></div></li>
          <li><span>03</span><div><strong>Class size and water depth</strong><p>Ask about the coach-to-learner ratio and shallow-water provision for beginners.</p></div></li>
          <li><span>04</span><div><strong>Full cost</strong><p>Confirm tuition, pool admission, equipment, session count, and make-up policy in writing.</p></div></li>
          <li><span>05</span><div><strong>Recent reviews</strong><p>Prioritize specific, recent reviews that include authentic photos and useful detail.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="local-directory__enterprise">
      <div class="container local-directory__enterprise-inner">
        <div><span>For organizations only</span><h2>Need swimming training for 10+ participants?</h2><p>Companies, schools, and residential communities can request a structured program based on scale, venue, and safety requirements.</p></div>
        <a href="/en/contact/">Request an organization program</a>
      </div>
    </section>
  </main>
</PageLayout>
