---
import RegionDirectoryPage from '../../components/locality/RegionDirectoryPage.astro';
import {locations} from '../../data/locations.js';
import {viProvinceToEn} from '../../utils/i18nRouting.js';
import {buildProvincePage} from '../../data/locality/province';
export function getStaticPaths(){return locations.map(loc=>({params:{location:viProvinceToEn(loc.slug)},props:{loc}}));}
const page=buildProvincePage(Astro.props.loc,'en');
---
<RegionDirectoryPage page={page} />
