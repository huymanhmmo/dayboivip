---
const currentYear = new Date().getFullYear();
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { seniors } from '../../../data/coursesEn.js';
import { generateCourseSchema } from '../../../utils/courseSchema.js';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Swimming Courses', href: '/en/courses/' },
  { label: 'Swimming for Seniors' },
];

const courseSchema = generateCourseSchema(seniors, 'https://dayboi.vip/en/courses/seniors/');
const combinedSchema = [courseSchema];
---

<CourseLayout
  course={seniors}
  breadcrumbs={breadcrumbs}
  schema={combinedSchema}
  lang="en"
  alternateUrl="/khoa-hoc-boi/nguoi-cao-tuoi/"
  alternateLang="vi"
/>
