---
const currentYear = new Date().getFullYear();
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { private1on1 } from '../../../data/coursesEn.js';
import { generateCourseSchema } from '../../../utils/courseSchema.js';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Swimming Courses', href: '/en/courses/' },
  { label: 'Private 1-on-1 Lessons' },
];

const courseSchema = generateCourseSchema(private1on1, 'https://dayboi.vip/en/courses/1-on-1/');
const combinedSchema = [courseSchema];
---

<CourseLayout
  course={private1on1}
  breadcrumbs={breadcrumbs}
  schema={combinedSchema}
  lang="en"
  alternateUrl="/khoa-hoc-boi/1-kem-1/"
  alternateLang="vi"
/>
