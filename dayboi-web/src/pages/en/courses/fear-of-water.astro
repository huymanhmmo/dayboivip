---
const currentYear = new Date().getFullYear();
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { fearOfWater } from '../../../data/coursesEn.js';
import { generateCourseSchema } from '../../../utils/courseSchema.js';

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Swimming Courses', href: '/en/courses/' },
  { label: 'Fear of Water Class' },
];

const courseSchema = generateCourseSchema(fearOfWater, 'https://dayboi.vip/en/courses/fear-of-water/');
const combinedSchema = [courseSchema];
---

<CourseLayout
  course={fearOfWater}
  breadcrumbs={breadcrumbs}
  schema={combinedSchema}
  lang="en"
  alternateUrl="/khoa-hoc-boi/nguoi-so-nuoc/"
  alternateLang="vi"
/>
