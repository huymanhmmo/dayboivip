---
import PoolDetailPage from '../components/pool-detail/PoolDetailPage.astro';
import {findVenue} from '../data/venues/catalog.js';
import {buildVenueDetail} from '../data/venues/buildVenueDetail';
const venue=findVenue('Bể bơi Tăng Bạt Hổ','hoc-boi-ha-noi');
if(!venue)throw new Error('Missing Tăng Bạt Hổ venue');
const pool=buildVenueDetail(venue);
---
<PoolDetailPage pool={pool} />
