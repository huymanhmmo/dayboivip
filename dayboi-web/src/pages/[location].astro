---
import RegionDirectoryPage from '../components/locality/RegionDirectoryPage.astro';
import {locations} from '../data/locations.js';
import {buildProvincePage} from '../data/locality/province';
export function getStaticPaths(){return locations.map(loc=>({params:{location:loc.slug},props:{loc}}));}
const page=buildProvincePage(Astro.props.loc,'vi');
---
<RegionDirectoryPage page={page} />
