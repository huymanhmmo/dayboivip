---
import PageLayout from '../layouts/PageLayout.astro';
import { locations } from '../data/locations.js';
import { getLocationResearch } from '../data/locationResearch.js';
import { getPublishedAreaUrl } from '../data/locationAreas.js';
import '../styles/location-directory.css';

export function getStaticPaths() {
  return locations.map((loc) => ({ params: { location: loc.slug }, props: { loc } }));
}

const { loc } = Astro.props;
const mapsSearch = (query) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const googleSearch = (query) => `https://www.google.com/search?q=${encodeURIComponent(query)}`;
const customerCopy = (value = '') => String(value)
  .replace(/cam kết 100%/gi, 'đặt mục tiêu thành thạo')
  .replace(/an toàn tuyệt đối/gi, 'ưu tiên an toàn cao nhất')
  .replace(/uy tín nhất/gi, 'được nhiều người biết đến')
  .replace(/uy tín số 1/gi, 'được nhiều học viên tin chọn')
  .replace(/hiện đại số 1/gi, 'hiện đại đạt chuẩn')
  .replace(/an toàn số 1/gi, 'tiêu chuẩn an toàn cao')
  .replace(/hoàn hảo nhất/gi, 'phù hợp');
const research = getLocationResearch(loc.slug);
const categories = research?.categories || [{
  id: 'starter',
  label: 'Danh sách đang chờ rà soát sâu',
  description: 'Các địa điểm được tổng hợp để người dùng tra cứu và lựa chọn cơ sở bơi lội thuận tiện nhất.',
  venues: loc.pools.map((pool) => ({
    name: pool.name,
    address: pool.address,
    area: loc.name,
    access: pool.type || 'Chưa xác định',
    detail: 'Thông tin khởi tạo chưa được rà soát sâu. Vui lòng dùng bản đồ và xác minh trực tiếp trước khi đến.',
    sourceLabel: 'Google Maps',
    sourceUrl: mapsSearch(`${pool.name}, ${pool.address || loc.name}`),
    sourceType: 'Bản đồ công khai',
  })),
}];
const poolDirectory = categories.flatMap((category) => category.venues.map((venue) => ({
  ...venue,
  category: category.label,
  mapsUrl: mapsSearch(`${venue.name}, ${venue.address || loc.name}`),
})));
const pageTitle = research?.providers
  ? `Học Bơi ${loc.name}: Bể Bơi & Lớp Học Theo Khu Vực`
  : `Học Bơi ${loc.name}: Danh Bạ Bể Bơi & Giáo Viên`;
const pageDescription = research?.providers
  ? `Danh sách bể bơi và trung tâm học bơi tại ${loc.name}, phân nhóm theo khu vực. Có đối tượng học, hình thức lớp, tiện ích và hướng dẫn liên hệ trực tiếp.`
  : `Tra cứu bể bơi, câu lạc bộ và giáo viên dạy bơi tại ${loc.name}. Người học chủ động kiểm tra và liên hệ trực tiếp với từng cơ sở.`;
const discoveryLinks = [
  { label: 'Tất cả bể bơi đang được niêm yết', desc: 'Xem giờ mở cửa, hình ảnh và vị trí thực tế trên bản đồ.', url: mapsSearch(`bể bơi tại ${loc.name}`), icon: 'pool' },
  { label: 'Lớp trẻ em & bơi sinh tồn', desc: 'Mở kết quả Google về lớp trẻ em, độ tuổi nhận học và chương trình an toàn dưới nước.', url: googleSearch(`học bơi trẻ em bơi sinh tồn ${loc.name}`), icon: 'coach' },
  { label: 'Lớp người lớn & kèm riêng', desc: 'Tìm trung tâm công khai lớp cho người lớn, người sợ nước hoặc nhu cầu học 1 kèm 1.', url: googleSearch(`học bơi người lớn kèm riêng 1 kèm 1 ${loc.name}`), icon: 'club' },
  { label: 'Khóa cấp tốc & trung tâm', desc: 'Khảo sát khóa cấp tốc, câu lạc bộ và lớp dạy bơi theo nhu cầu tại địa phương.', url: googleSearch(`khóa học bơi cấp tốc trung tâm dạy bơi ${loc.name}`), icon: 'public' },
];

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Toàn quốc', href: '/hoc-boi-o-dau/' },
  { label: loc.name },
];

const locationFaqs = [
  {
    question: `Học bơi tại ${loc.name} học phí khoảng bao nhiêu?`,
    answer: `Học phí học bơi tại ${loc.name} thường dao động từ 1.500.000đ - 3.500.000đ/khóa tùy hình thức học nhóm hay 1 kèm 1 và cơ sở vật chất bể bơi. Người học nên liên hệ trực tiếp đơn vị tại địa phương để xác nhận chi tiết vé bể và học phí.`,
  },
  {
    question: `Lớp học bơi ở ${loc.name} nhận học viên từ mấy tuổi?`,
    answer: `Đa số các bể bơi và trung tâm tại ${loc.name} nhận dạy học viên từ 5 tuổi trở lên đối với trẻ em và không giới hạn độ tuổi với người lớn. Trẻ dưới 5 tuổi nên tham gia các lớp làm quen nước cùng phụ huynh.`,
  },
  {
    question: `Tại ${loc.name} có bể bơi bốn mùa nước ấm không?`,
    answer: `Tại các khu vực đô thị của ${loc.name}, có các cơ sở bể bơi bốn mùa nước ấm trong nhà phục vụ tập luyện quanh năm kể cả mùa đông. Hãy tra cứu danh sách cơ sở chi tiết trong trang.`,
  }
];

const directorySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `https://dayboi.vip/${loc.slug}/#page`,
      name: `Danh bạ bể bơi và đơn vị dạy bơi tại ${loc.name}`,
      description: `Danh sách tham khảo các bể bơi, câu lạc bộ và công cụ tìm giáo viên dạy bơi có thông tin công khai tại ${loc.name}.`,
      url: `https://dayboi.vip/${loc.slug}/`,
      mainEntity: { '@id': `https://dayboi.vip/${loc.slug}/#venues` },
    },
    {
      '@type': 'ItemList',
      '@id': `https://dayboi.vip/${loc.slug}/#venues`,
      numberOfItems: poolDirectory.length,
      itemListElement: poolDirectory.map((pool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'SportsActivityLocation',
          '@id': `https://dayboi.vip/${loc.slug}/#venue-${index + 1}`,
          name: pool.name,
          address: {
            '@type': 'PostalAddress',
            streetAddress: pool.address || `${pool.name}, ${loc.name}`,
            addressLocality: pool.area || loc.name,
            addressRegion: loc.name,
            addressCountry: 'VN',
          },
          telephone: pool.venueContact?.phone || (pool.instructors && pool.instructors[0]?.phone) || undefined,
          url: `https://dayboi.vip/${loc.slug}/#venue-${index + 1}`,
          description: pool.detail || pool.services || `Địa điểm học bơi và hồ bơi tại ${pool.name}, ${loc.name}.`,
        },
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: locationFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://dayboi.vip/${loc.slug}/`}
  image={loc.image}
  type="website"
  breadcrumbs={breadcrumbs}
  schema={directorySchema}
>
  <div class="local-directory">
    <section class="local-directory__hero">
      <div class="container local-directory__hero-grid">
        <div>
          <nav class="local-directory__tree-path" aria-label="Vị trí trong danh bạ">
            <a href="/hoc-boi-o-dau/">Toàn quốc</a><span>›</span><strong>{loc.name}</strong><span>›</span><small>{categories.length} khu vực</small>
          </nav>
          <span class="local-directory__eyebrow">Tỉnh, thành phố · {loc.region}</span>
          <h1>Học bơi tại <span>{loc.name}</span>: bể bơi, lớp học & nơi dạy bơi</h1>
          <p>Tìm bể bơi, câu lạc bộ hoặc giáo viên dạy bơi tại {loc.name}; xem địa chỉ, đối tượng nhận học và cách liên hệ. Bạn cũng có thể chọn hướng dẫn bơi ếch, bơi sải, bơi ngửa hoặc bơi bướm theo mục tiêu của mình.</p>
          <div class={`local-directory__research-status ${research ? 'is-reviewed' : ''}`}>
            <strong>Thông tin học bơi theo khu vực</strong>
            <span>{research ? `${poolDirectory.length} địa điểm · cập nhật ${research.reviewedAt}` : 'Hãy xác minh lịch và giá trực tiếp với đơn vị'}</span>
          </div>
          <div class="local-directory__hero-actions">
            <a href="#danh-sach">Xem bể bơi và lớp học</a>
            <a href={mapsSearch(`học bơi tại ${loc.name}`)} target="_blank" rel="noopener noreferrer">Tìm toàn bộ trên bản đồ</a>
          </div>
        </div>
        <figure>
          <img src={loc.image} alt={`Minh họa hoạt động bơi lội tại ${loc.name}`} width="680" height="510" loading="eager" />
          <figcaption>Ảnh minh họa hoạt động bơi lội; không đại diện cho một cơ sở cụ thể.</figcaption>
        </figure>
      </div>
    </section>

    <section class="local-directory__notice">
      <div class="container">
        <strong>Lưu ý trước khi liên hệ</strong>
        <p>Giờ mở cửa, học phí, HLV và số điện thoại có thể thay đổi. Hãy kiểm tra thông tin mới nhất, đọc đánh giá gần đây và xác nhận trực tiếp với đơn vị trước khi đến. Hệ thống không bảo chứng chất lượng cho bất kỳ bên thứ ba nào.</p>
      </div>
    </section>

    {research?.groupingNote && (
      <section class="local-directory__admin-note" aria-label="Lưu ý về đơn vị hành chính">
        <div class="container"><strong>Cách phân nhóm khu vực</strong><p>{research.groupingNote}</p></div>
      </section>
    )}

    <section class="section" aria-labelledby="discovery-title">
      <div class="container">
        <div class="section__header">
          <span class="section__badge">Tra cứu theo nhu cầu</span>
          <h2 class="section__title" id="discovery-title">Tìm đúng loại đơn vị tại {loc.name}</h2>
          <p class="section__desc">Chọn đúng nhu cầu để xem thêm địa điểm, giờ mở cửa, hình ảnh và đánh giá gần đây.</p>
        </div>
        <div class="local-directory__discovery-grid">
          {discoveryLinks.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="local-directory__discovery-card">
              <span class={`local-directory__icon local-directory__icon--${item.icon}`} aria-hidden="true"></span>
              <strong>{item.label}</strong>
              <p>{item.desc}</p>
              <span>Xem kết quả mới nhất <b>↗</b></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--alt" id="danh-sach" aria-labelledby="pool-list-title">
      <div class="container">
        <div class="section__header">
          <span class="section__badge">{research?.providers ? 'Chọn khu vực gần bạn' : 'Chọn theo loại địa điểm'}</span>
          <h2 class="section__title" id="pool-list-title">Bể bơi và đơn vị tại {loc.name}</h2>
          <p class="section__desc">{customerCopy(research?.summary || 'Danh sách giúp bạn tham khảo địa điểm bơi lội tại địa phương.')} Danh sách không phải bảng xếp hạng hoặc chứng nhận chất lượng.</p>
        </div>
        <nav class="local-directory__category-nav" aria-label="Các khu vực và loại địa điểm">
          {categories.map((category) => {
            const areaUrl = getPublishedAreaUrl(loc.slug, category.id);
            return <a href={areaUrl || `#${category.id}`} class:list={{ 'has-area-page': areaUrl }}>
              {category.label}
              <span>{category.venues.length}{areaUrl && <small>trang riêng</small>}</span>
            </a>;
          })}
        </nav>
        <div class="local-directory__categories">
          {categories.map((category) => (
            <section class="local-directory__category" id={category.id} aria-labelledby={`${category.id}-title`}>
              <header>
                <div>
                  <span>{String(category.venues.length).padStart(2, '0')} địa điểm</span>
                  <h3 id={`${category.id}-title`}>{category.label}</h3>
                </div>
                <div>
                  <p>{customerCopy(category.description)}</p>
                  {getPublishedAreaUrl(loc.slug, category.id) && (
                    <a class="local-directory__area-link" href={getPublishedAreaUrl(loc.slug, category.id)}>
                      Xem thông tin học bơi {category.label.replace('Khu vực ', '')} →
                    </a>
                  )}
                </div>
              </header>
              <div class="local-directory__pool-grid">
                {category.venues.map((pool, index) => (
                  <article class="local-directory__pool-card">
                    <div class="local-directory__pool-index">{String(index + 1).padStart(2, '0')}</div>
                    <div>
                      <div class="local-directory__pool-meta">
                        <span>{pool.area || loc.name}</span>
                        <span>{customerCopy(pool.entityType || pool.access || 'Chưa xác định')}</span>
                        {pool.environment && <span>{customerCopy(pool.environment)}</span>}
                      </div>
                      <h4>{pool.name}</h4>
                      {pool.address && <p><strong>Địa chỉ:</strong> {pool.address}</p>}
                      {pool.services && <p><strong>Cơ sở vật chất & tiện ích:</strong> {customerCopy(pool.services)}</p>}
                      <p><strong>Phù hợp với:</strong> {customerCopy(pool.detail)}</p>

                      {pool.venueContact && (
                        <div class="local-directory__venue-contact">
                          <div class="local-directory__contact-badge">📞 Liên hệ Bể bơi / Ban quản lý</div>
                          <div class="local-directory__contact-body">
                            <p><strong>{pool.venueContact.name}</strong> ({pool.venueContact.role})</p>
                            <p class="local-directory__contact-phone">
                              <span>Hotline / ĐT:</span>
                              <a href={`tel:${pool.venueContact.phone.split(' ')[0].replace(/[^0-9+]/g, '')}`}>{pool.venueContact.phone}</a>
                            </p>
                            {pool.venueContact.note && <p class="local-directory__contact-note">{customerCopy(pool.venueContact.note)}</p>}
                            {pool.venueContact.exactSourceUrl && (
                              <a href={pool.venueContact.exactSourceUrl} target="_blank" rel="noopener noreferrer" class="local-directory__source-link">
                                📄 Xem thông tin công khai: {pool.venueContact.sourceTitle || 'Mở trang thông tin'} ↗
                              </a>
                            )}
                          </div>
                        </div>
                      )}

                      {pool.instructors?.length > 0 && (
                        <div class="local-directory__pool-instructors">
                          <h5>🏊 Giáo viên & Trung tâm dạy bơi tại bể này ({pool.instructors.length}):</h5>
                          <div class="local-directory__instructor-list">
                            {pool.instructors.map((inst) => (
                              <div class="local-directory__instructor-item">
                                <div class="local-directory__instructor-header">
                                  <strong>{inst.unitName}</strong>
                                  <span class="local-directory__instructor-person">HLV: {inst.contactPerson}</span>
                                </div>
                                <p class="local-directory__instructor-phone">
                                  <span>Đăng ký học bơi:</span>
                                  <a href={`tel:${inst.phone.split(' ')[0].replace(/[^0-9+]/g, '')}`}><strong>{inst.phone}</strong></a>
                                </p>
                                <p class="local-directory__instructor-courses"><strong>Khóa học:</strong> {customerCopy(inst.courseTypes)}</p>
                                {inst.exactSourceUrl && (
                                  <a href={inst.exactSourceUrl} target="_blank" rel="noopener noreferrer" class="local-directory__source-link">
                                    🔗 Xem thông tin lớp: {inst.sourceTitle || 'Xem thông tin chi tiết'} ↗
                                  </a>
                                )}
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {pool.missing && <p class="local-directory__missing"><strong>Lưu ý:</strong> {customerCopy(pool.missing)}</p>}
                    </div>
                    <div class="local-directory__pool-links">
                      <a href={mapsSearch(`${pool.name}, ${pool.address || loc.name}`)} target="_blank" rel="noopener noreferrer">Bản đồ & chỉ đường ↗</a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    {research?.providers?.length > 0 && (
      <section class="section local-directory__providers" aria-labelledby="provider-title">
        <div class="container">
          <div class="section__header">
            <span class="section__badge">Đơn vị có thông tin công khai</span>
            <h2 class="section__title" id="provider-title">Trung tâm và câu lạc bộ dạy bơi tại {loc.name}</h2>
            <p class="section__desc">Danh sách này tách khỏi danh sách bể bơi. Một đơn vị có thể dạy tại nhiều bể; một bể cũng có thể được nhiều đơn vị sử dụng.</p>
          </div>
          <div class="local-directory__provider-grid">
            {research.providers.map((provider) => (
              <article class="local-directory__provider-card">
                <div class="local-directory__provider-top"><span>{provider.kind}</span></div>
                <h3>{provider.name}</h3>
                <dl>
                  <div><dt>Khu vực</dt><dd>{provider.areas}</dd></div>
                  <div><dt>Đối tượng</dt><dd>{provider.audiences}</dd></div>
                  <div><dt>Hình thức</dt><dd>{customerCopy(provider.formats)}</dd></div>
                  {provider.contact && <div><dt>Liên hệ công khai</dt><dd>{provider.contact}</dd></div>}
                </dl>
                <p><strong>Thông tin đã có:</strong> {customerCopy(provider.verification)}</p>
                <p class="local-directory__missing"><strong>Cần hỏi thêm:</strong> {customerCopy(provider.missing)}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section local-directory__method" aria-labelledby="method-title">
      <div class="container local-directory__method-grid">
        <div>
          <span class="section__badge">Cách đọc danh sách</span>
          <h2 class="section__title" id="method-title">Thông tin nào cần kiểm tra trước khi đi?</h2>
        </div>
        <div class="local-directory__method-list">
          <p><strong>1. Đúng địa chỉ</strong><span>Mở bản đồ để kiểm tra lối vào, chỗ gửi xe và quãng đường từ nhà đến bể.</span></p>
          <p><strong>2. Có được vào bể</strong><span>Bể công cộng, khách sạn và hồ nội khu có quy định khách ngoài khác nhau.</span></p>
          <p><strong>3. Lịch và tổng chi phí</strong><span>Hỏi lại giờ mở cửa, lịch giáo viên, học phí và vé bể trước khi đăng ký.</span></p>
        </div>
      </div>
    </section>



    {research?.relatedPages?.length > 0 && (
      <section class="section local-directory__related" aria-labelledby="related-title">
        <div class="container">
          <div class="section__header">
            <span class="section__badge">Liên kết theo khu vực</span>
            <h2 class="section__title" id="related-title">Địa phương và khu vực liên quan</h2>
            <p class="section__desc">Tiếp tục tra cứu theo khu vực gần nơi ở thay vì chọn lớp chỉ dựa trên quảng cáo.</p>
          </div>
          <div class="local-directory__related-grid">
            {research.relatedPages.map((page) => (
              <a href={page.href}><strong>{page.label}</strong><span>{page.description}</span><b>Xem trang →</b></a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="check-title">
      <div class="container local-directory__check-grid">
        <div>
          <span class="section__badge">Tự đánh giá trước khi học</span>
          <h2 class="section__title" id="check-title">5 điểm cần xác nhận trực tiếp</h2>
          <p class="section__desc">Không chuyển khoản hoặc đăng ký dài hạn trước khi bạn xác minh được đơn vị và người dạy.</p>
        </div>
        <ol>
          <li><span>01</span><div><strong>Danh tính và chứng chỉ HLV</strong><p>Yêu cầu xem chứng chỉ chuyên môn, cứu hộ còn hiệu lực và kinh nghiệm với đúng nhóm tuổi.</p></div></li>
          <li><span>02</span><div><strong>Nhân viên cứu hộ tại bể</strong><p>Xác nhận ca học luôn có cứu hộ, phao và quy trình xử lý sự cố.</p></div></li>
          <li><span>03</span><div><strong>Sĩ số và độ sâu</strong><p>Hỏi rõ số học viên trên mỗi HLV và khu vực nước nông dành cho người mới.</p></div></li>
          <li><span>04</span><div><strong>Chi phí đầy đủ</strong><p>Xác nhận học phí, vé bể, dụng cụ, số buổi và chính sách nghỉ/bù bằng văn bản.</p></div></li>
          <li><span>05</span><div><strong>Đánh giá gần đây</strong><p>Ưu tiên đánh giá có ảnh thật, nội dung cụ thể và được đăng trong thời gian gần.</p></div></li>
        </ol>
      </div>
    </section>

