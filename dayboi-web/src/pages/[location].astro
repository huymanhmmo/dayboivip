---
import PageLayout from '../layouts/PageLayout.astro';
import { locations } from '../data/locations.js';
import { getLocationResearch } from '../data/locationResearch.js';
import '../styles/location-directory.css';

export function getStaticPaths() {
  return locations.map((loc) => ({ params: { location: loc.slug }, props: { loc } }));
}

const { loc } = Astro.props;
const currentYear = new Date().getFullYear();
const mapsSearch = (query) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const googleSearch = (query) => `https://www.google.com/search?q=${encodeURIComponent(query)}`;
const research = getLocationResearch(loc.slug);
const categories = research?.categories || [{
  id: 'starter',
  label: 'Danh sách đang chờ rà soát sâu',
  description: 'Các địa điểm khởi tạo được giữ lại để người dùng tra cứu; nhóm biên tập sẽ bổ sung nguồn và phân loại trong các đợt tiếp theo.',
  venues: loc.pools.map((pool) => ({
    name: pool.name,
    address: pool.address,
    area: loc.name,
    access: pool.type || 'Chưa xác định',
    detail: 'Thông tin khởi tạo chưa được rà soát sâu. Vui lòng dùng bản đồ và xác minh trực tiếp trước khi đến.',
    sourceLabel: 'Google Maps',
    sourceUrl: mapsSearch(`${pool.name}, ${pool.address || loc.name}`),
    sourceType: 'Bản đồ công khai',
  })),
}];
const poolDirectory = categories.flatMap((category) => category.venues.map((venue) => ({
  ...venue,
  category: category.label,
  mapsUrl: mapsSearch(`${venue.name}, ${venue.address || loc.name}`),
})));
const pageTitle = research?.providers
  ? `Địa Điểm & Trung Tâm Học Bơi ${loc.name} Theo Khu Vực [${currentYear}]`
  : `Danh Bạ Bể Bơi & Giáo Viên Dạy Bơi ${loc.name} [${currentYear}]`;
const pageDescription = research?.providers
  ? `Danh sách bể bơi và trung tâm học bơi tại ${loc.name}, phân nhóm theo khu vực. Có đối tượng học, hình thức lớp, liên hệ, thông tin còn thiếu và nguồn đối chiếu.`
  : `Tra cứu bể bơi, câu lạc bộ và giáo viên dạy bơi có thông tin công khai tại ${loc.name}. Người học chủ động kiểm tra và liên hệ trực tiếp với từng đơn vị.`;
const discoveryLinks = [
  { label: 'Tất cả bể bơi đang được niêm yết', desc: 'Xem giờ mở cửa, website và số liên hệ công khai trên bản đồ.', url: mapsSearch(`bể bơi tại ${loc.name}`), icon: 'pool' },
  { label: 'Lớp trẻ em & bơi sinh tồn', desc: 'Mở kết quả Google về lớp trẻ em, độ tuổi nhận học và chương trình an toàn dưới nước.', url: googleSearch(`học bơi trẻ em bơi sinh tồn ${loc.name}`), icon: 'coach' },
  { label: 'Lớp người lớn & kèm riêng', desc: 'Tìm trung tâm công khai lớp cho người lớn, người sợ nước hoặc nhu cầu học 1 kèm 1.', url: googleSearch(`học bơi người lớn kèm riêng 1 kèm 1 ${loc.name}`), icon: 'club' },
  { label: 'Khóa cấp tốc & trung tâm', desc: 'Đối chiếu khóa cấp tốc, câu lạc bộ và trung tâm dạy bơi trên các website công khai.', url: googleSearch(`khóa học bơi cấp tốc trung tâm dạy bơi ${loc.name}`), icon: 'public' },
];

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Địa điểm', href: '/hoc-boi-o-dau/' },
  { label: loc.name },
];

const directorySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Danh bạ bể bơi và đơn vị dạy bơi tại ${loc.name}`,
  description: `Danh sách tham khảo các bể bơi, câu lạc bộ và công cụ tìm giáo viên dạy bơi có thông tin công khai tại ${loc.name}.`,
  url: `https://dayboi.vip/${loc.slug}/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: poolDirectory.length,
    itemListElement: poolDirectory.map((pool, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: pool.name,
      url: pool.mapsUrl,
    })),
  },
};
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://dayboi.vip/${loc.slug}/`}
  image={loc.image}
  type="website"
  breadcrumbs={breadcrumbs}
  schema={directorySchema}
>
  <main class="local-directory">
    <section class="local-directory__hero">
      <div class="container local-directory__hero-grid">
        <div>
          <span class="local-directory__eyebrow">Địa điểm độc lập · {loc.region}</span>
          <h1>Bể bơi & nơi dạy bơi tại <span>{loc.name}</span></h1>
          <p>Trang này giúp người học cá nhân chủ động tìm và liên hệ trực tiếp với bể bơi, câu lạc bộ hoặc giáo viên đang công khai dịch vụ tại {loc.name}. Swim For Life không nhận đăng ký, không thu phí và không đại diện cho các đơn vị được liệt kê.</p>
          <div class={`local-directory__research-status ${research ? 'is-reviewed' : ''}`}>
            <strong>{research?.level || 'Đang chờ rà soát chi tiết'}</strong>
            <span>{research ? `${poolDirectory.length} địa điểm có nguồn · cập nhật ${research.reviewedAt}` : 'Thông tin khởi tạo · cần xác minh trực tiếp'}</span>
          </div>
          <div class="local-directory__hero-actions">
            <a href="#danh-sach">Xem danh sách tham khảo</a>
            <a href={mapsSearch(`học bơi tại ${loc.name}`)} target="_blank" rel="noopener noreferrer">Tìm toàn bộ trên bản đồ</a>
          </div>
        </div>
        <figure>
          <img src={loc.image} alt={`Minh họa hoạt động bơi lội tại ${loc.name}`} width="680" height="510" loading="eager" />
          <figcaption>Ảnh minh họa hoạt động bơi lội; không đại diện cho một cơ sở cụ thể.</figcaption>
        </figure>
      </div>
    </section>

    <section class="local-directory__notice">
      <div class="container">
        <strong>Lưu ý trước khi liên hệ</strong>
        <p>Giờ mở cửa, học phí, HLV và số điện thoại có thể thay đổi. Hãy kiểm tra listing mới nhất, đọc đánh giá gần đây và xác nhận trực tiếp với đơn vị trước khi đến. Website không bảo chứng chất lượng cho bất kỳ bên thứ ba nào.</p>
      </div>
    </section>

    {research?.groupingNote && (
      <section class="local-directory__admin-note" aria-label="Lưu ý về đơn vị hành chính">
        <div class="container"><strong>Cách phân nhóm khu vực</strong><p>{research.groupingNote}</p></div>
      </section>
    )}

    <section class="section" aria-labelledby="discovery-title">
      <div class="container">
        <div class="section__header">
          <span class="section__badge">Tra cứu theo nhu cầu</span>
          <h2 class="section__title" id="discovery-title">Tìm đúng loại đơn vị tại {loc.name}</h2>
          <p class="section__desc">Các liên kết dưới đây mở kết quả Google và Google Maps theo thời gian thực để bạn xem thông tin công khai và liên hệ trực tiếp.</p>
        </div>
        <div class="local-directory__discovery-grid">
          {discoveryLinks.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="local-directory__discovery-card">
              <span class={`local-directory__icon local-directory__icon--${item.icon}`} aria-hidden="true"></span>
              <strong>{item.label}</strong>
              <p>{item.desc}</p>
              <span>Xem kết quả mới nhất <b>↗</b></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--alt" id="danh-sach" aria-labelledby="pool-list-title">
      <div class="container">
        <div class="section__header">
          <span class="section__badge">{research?.providers ? 'Theo cụm khu vực quen dùng' : 'Theo từng loại địa điểm'}</span>
          <h2 class="section__title" id="pool-list-title">Bể bơi và đơn vị tại {loc.name}</h2>
          <p class="section__desc">{research?.summary || 'Trang này đang ở lớp dữ liệu khởi tạo và sẽ được bổ sung nguồn theo lộ trình toàn quốc.'} Danh sách không phải bảng xếp hạng hoặc chứng nhận chất lượng.</p>
        </div>
        <nav class="local-directory__category-nav" aria-label="Các khu vực và loại địa điểm">
          {categories.map((category) => <a href={`#${category.id}`}>{category.label}<span>{category.venues.length}</span></a>)}
        </nav>
        <div class="local-directory__categories">
          {categories.map((category) => (
            <section class="local-directory__category" id={category.id} aria-labelledby={`${category.id}-title`}>
              <header>
                <div>
                  <span>{String(category.venues.length).padStart(2, '0')} địa điểm</span>
                  <h3 id={`${category.id}-title`}>{category.label}</h3>
                </div>
                <p>{category.description}</p>
              </header>
              <div class="local-directory__pool-grid">
                {category.venues.map((pool, index) => (
                  <article class="local-directory__pool-card">
                    <div class="local-directory__pool-index">{String(index + 1).padStart(2, '0')}</div>
                    <div>
                      <div class="local-directory__pool-meta">
                        <span>{pool.area || loc.name}</span>
                        <span>{pool.entityType || pool.access || 'Chưa xác định'}</span>
                        {pool.environment && <span>{pool.environment}</span>}
                      </div>
                      <h4>{pool.name}</h4>
                      {pool.address && <p><strong>Địa chỉ tham khảo:</strong> {pool.address}</p>}
                      {pool.services && <p><strong>Khóa học / đối tượng đã xác minh:</strong> {pool.services}</p>}
                      <p><strong>Ghi chú:</strong> {pool.detail}</p>
                      {pool.missing && <p class="local-directory__missing"><strong>Còn thiếu:</strong> {pool.missing}</p>}
                    </div>
                    <div class="local-directory__pool-links">
                      <a href={mapsSearch(`${pool.name}, ${pool.address || loc.name}`)} target="_blank" rel="noopener noreferrer">Bản đồ & liên hệ ↗</a>
                      <a href={pool.sourceUrl} target="_blank" rel="noopener noreferrer" class="is-source">Nguồn: {pool.sourceLabel} ↗</a>
                    </div>
                    <small>{pool.sourceType} · rà soát {research?.reviewedAt || 'theo lộ trình'}</small>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    {research?.providers?.length > 0 && (
      <section class="section local-directory__providers" aria-labelledby="provider-title">
        <div class="container">
          <div class="section__header">
            <span class="section__badge">Đơn vị tổ chức lớp đã đối chiếu</span>
            <h2 class="section__title" id="provider-title">Trung tâm và câu lạc bộ dạy bơi tại {loc.name}</h2>
            <p class="section__desc">Danh sách này tách khỏi danh sách bể bơi. Một đơn vị có thể dạy tại nhiều bể; một bể cũng có thể được nhiều đơn vị sử dụng.</p>
          </div>
          <div class="local-directory__provider-grid">
            {research.providers.map((provider) => (
              <article class="local-directory__provider-card">
                <div class="local-directory__provider-top"><span>{provider.kind}</span><a href={provider.website} target="_blank" rel="noopener noreferrer">Website ↗</a></div>
                <h3>{provider.name}</h3>
                <dl>
                  <div><dt>Khu vực</dt><dd>{provider.areas}</dd></div>
                  <div><dt>Đối tượng</dt><dd>{provider.audiences}</dd></div>
                  <div><dt>Hình thức</dt><dd>{provider.formats}</dd></div>
                  {provider.contact && <div><dt>Liên hệ công khai</dt><dd>{provider.contact}</dd></div>}
                </dl>
                <p><strong>Đã xác minh:</strong> {provider.verification}</p>
                <p class="local-directory__missing"><strong>Còn thiếu:</strong> {provider.missing}</p>
                <a href={provider.sourceUrl} target="_blank" rel="noopener noreferrer" class="local-directory__provider-source">Nguồn: {provider.sourceLabel} ↗</a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section local-directory__method" aria-labelledby="method-title">
      <div class="container local-directory__method-grid">
        <div>
          <span class="section__badge">Phương pháp biên tập</span>
          <h2 class="section__title" id="method-title">Nguồn được hiển thị để bạn tự đối chiếu</h2>
        </div>
        <div class="local-directory__method-list">
          <p><strong>1. Xác nhận định danh</strong><span>Tên, địa chỉ và loại hình được đối chiếu từ nguồn đơn vị, cơ quan, báo chí hoặc danh bạ công khai.</span></p>
          <p><strong>2. Gắn mức độ tiếp cận</strong><span>Phân biệt bể công cộng, thương mại, tổ hợp thể thao và hồ nội khu để tránh đến nhầm.</span></p>
          <p><strong>3. Không sao chép giá cũ</strong><span>Giá vé, giờ mở cửa và lịch giáo viên biến động nhanh nên người dùng phải xác nhận với nơi vận hành.</span></p>
        </div>
      </div>
    </section>

    {research?.references?.length > 0 && (
      <section class="section section--alt local-directory__references" aria-labelledby="references-title">
        <div class="container local-directory__references-grid">
          <div>
            <span class="section__badge">Tài liệu đối chiếu</span>
            <h2 class="section__title" id="references-title">Nguồn tham khảo cho {loc.name}</h2>
            <p class="section__desc">Ưu tiên website chính thức và tài liệu cơ quan; nguồn của đơn vị dạy chỉ được dùng cho thông tin họ tự công bố.</p>
          </div>
          <ol>
            {research.references.map((source) => (
              <li><a href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.publisher}</strong><span>{source.title}</span></a><p>{source.usedFor}</p></li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {research?.relatedPages?.length > 0 && (
      <section class="section local-directory__related" aria-labelledby="related-title">
        <div class="container">
          <div class="section__header">
            <span class="section__badge">Liên kết theo khu vực</span>
            <h2 class="section__title" id="related-title">Địa phương và khu vực liên quan</h2>
            <p class="section__desc">Tiếp tục tra cứu theo khu vực gần nơi ở thay vì chọn lớp chỉ dựa trên quảng cáo.</p>
          </div>
          <div class="local-directory__related-grid">
            {research.relatedPages.map((page) => (
              <a href={page.href}><strong>{page.label}</strong><span>{page.description}</span><b>Xem trang →</b></a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="check-title">
      <div class="container local-directory__check-grid">
        <div>
          <span class="section__badge">Tự đánh giá trước khi học</span>
          <h2 class="section__title" id="check-title">5 điểm cần xác nhận trực tiếp</h2>
          <p class="section__desc">Không chuyển khoản hoặc đăng ký dài hạn trước khi bạn xác minh được đơn vị và người dạy.</p>
        </div>
        <ol>
          <li><span>01</span><div><strong>Danh tính và chứng chỉ HLV</strong><p>Yêu cầu xem chứng chỉ chuyên môn, cứu hộ còn hiệu lực và kinh nghiệm với đúng nhóm tuổi.</p></div></li>
          <li><span>02</span><div><strong>Nhân viên cứu hộ tại bể</strong><p>Xác nhận ca học luôn có cứu hộ, phao và quy trình xử lý sự cố.</p></div></li>
          <li><span>03</span><div><strong>Sĩ số và độ sâu</strong><p>Hỏi rõ số học viên trên mỗi HLV và khu vực nước nông dành cho người mới.</p></div></li>
          <li><span>04</span><div><strong>Chi phí đầy đủ</strong><p>Xác nhận học phí, vé bể, dụng cụ, số buổi và chính sách nghỉ/bù bằng văn bản.</p></div></li>
          <li><span>05</span><div><strong>Đánh giá gần đây</strong><p>Ưu tiên đánh giá có ảnh thật, nội dung cụ thể và được đăng trong thời gian gần.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="local-directory__enterprise">
      <div class="container local-directory__enterprise-inner">
        <div>
          <span>Chỉ dành cho tổ chức</span>
          <h2>Cần triển khai đào tạo bơi quy mô từ 10 người?</h2>
          <p>Doanh nghiệp, trường học và khu dân cư có thể gửi yêu cầu để nhận đề xuất chương trình theo quy mô, địa điểm và tiêu chuẩn an toàn riêng.</p>
        </div>
        <a href="/khoa-hoc-boi/doanh-nghiep/">Xem giải pháp đào tạo tổ chức</a>
      </div>
    </section>
  </main>
</PageLayout>
