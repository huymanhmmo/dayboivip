---
// MotionSteps.astro - Khối minh họa chuyển động từng bước kỹ thuật bơi chuyên sâu
export interface StepItem {
  number: number | string;
  phase: string;
  name: string;
  rhythm?: string;
  rhythmType?: 'slow' | 'fast' | 'glide' | 'steady';
  description: string;
  keyPoints?: string[];
  coachTip?: string;
  icon?: string;
}

export interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  steps: StepItem[];
  mantra?: string;
}

const { title, subtitle, badge = 'CHUYỂN ĐỘNG CHUẨN', steps, mantra } = Astro.props;
---

<div class="motion-stepper-widget">
  <div class="stepper-header">
    <div class="stepper-badge">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <span>{badge}</span>
    </div>
    <h3 class="stepper-title">{title}</h3>
    {subtitle && <p class="stepper-subtitle">{subtitle}</p>}
  </div>

  <div class="stepper-grid" style={`--total-steps: ${steps.length}`}>
    {steps.map((step, idx) => (
      <div class="step-card" data-step={idx + 1}>
        <div class="step-card-top">
          <div class="step-num-pill">
            <span class="num-text">{step.number || idx + 1}</span>
          </div>
          <div class="step-meta">
            <span class="step-phase-tag">{step.phase}</span>
            {step.rhythm && (
              <span class={`step-rhythm-badge rhythm--${step.rhythmType || 'steady'}`}>
                {step.rhythmType === 'fast' && '⚡ '}
                {step.rhythmType === 'slow' && '⏳ '}
                {step.rhythmType === 'glide' && '🌊 '}
                {step.rhythm}
              </span>
            )}
          </div>
        </div>

        <h4 class="step-name">
          {step.icon && <span class="step-icon">{step.icon}</span>}
          {step.name}
        </h4>

        <p class="step-desc">{step.description}</p>

        {step.keyPoints && step.keyPoints.length > 0 && (
          <ul class="step-keypoints">
            {step.keyPoints.map(point => (
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="point-check">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        )}

        {step.coachTip && (
          <div class="step-coach-tip">
            <span class="tip-icon">💡</span>
            <div class="tip-content">
              <strong>Mẹo HLV:</strong> {step.coachTip}
            </div>
          </div>
        )}
      </div>
    ))}
  </div>

  {mantra && (
    <div class="stepper-mantra-box">
      <div class="mantra-icon">🎯</div>
      <div class="mantra-content">
        <span class="mantra-label">THẦN CHÚ GHI NHỚ ĐỘNG TÁC:</span>
        <strong class="mantra-text">"{mantra}"</strong>
      </div>
    </div>
  )}
</div>

<style>
  .motion-stepper-widget {
    margin: var(--space-8) 0;
    padding: var(--space-6);
    background: linear-gradient(180deg, rgba(240, 249, 255, 0.8) 0%, rgba(255, 255, 255, 0.95) 100%);
    border: 1px solid rgba(0, 119, 182, 0.16);
    border-radius: var(--radius-2xl);
    box-shadow: 0 10px 30px rgba(0, 119, 182, 0.05);
    position: relative;
    overflow: hidden;
  }

  .motion-stepper-widget::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary), var(--color-accent));
  }

  .stepper-header {
    margin-bottom: var(--space-6);
  }

  .stepper-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: rgba(0, 119, 182, 0.1);
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
  }

  .stepper-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-2) 0;
    line-height: var(--leading-tight);
  }

  .stepper-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .stepper-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .step-card {
    background: #ffffff;
    border: 1px solid rgba(0, 119, 182, 0.12);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 14px rgba(2, 48, 71, 0.03);
    transition: all var(--transition-normal);
    position: relative;
  }

  .step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 119, 182, 0.1);
    border-color: var(--color-secondary);
  }

  .step-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .step-num-pill {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: #ffffff;
    font-weight: 800;
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 119, 182, 0.25);
    flex-shrink: 0;
  }

  .step-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .step-phase-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
  }

  .step-rhythm-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .rhythm--slow {
    background: #fef3c7;
    color: #92400e;
  }

  .rhythm--fast {
    background: #fee2e2;
    color: #991b1b;
  }

  .rhythm--glide {
    background: #e0f2fe;
    color: #0369a1;
  }

  .rhythm--steady {
    background: #e0e7ff;
    color: #3730a3;
  }

  .step-name {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 var(--space-2) 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .step-icon {
    font-size: 1.1em;
  }

  .step-desc {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-3) 0;
  }

  .step-keypoints {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3) 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
  }

  .step-keypoints li {
    font-size: 12.5px;
    color: var(--color-text-muted);
    line-height: 1.4;
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .point-check {
    color: #10b981;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .step-coach-tip {
    margin-top: auto;
    padding: 8px 10px;
    background: rgba(255, 183, 3, 0.1);
    border-left: 3px solid var(--color-accent);
    border-radius: 4px;
    font-size: 12px;
    line-height: 1.4;
    color: #78350f;
    display: flex;
    gap: 6px;
  }

  .tip-icon {
    flex-shrink: 0;
  }

  .stepper-mantra-box {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: linear-gradient(135deg, #023e8a 0%, #0077b6 100%);
    border-radius: var(--radius-xl);
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    box-shadow: 0 6px 20px rgba(2, 62, 138, 0.2);
  }

  .mantra-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .mantra-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mantra-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #caf0f8;
    font-weight: 700;
  }

  .mantra-text {
    font-size: var(--text-base);
    color: #ffffff;
    font-family: var(--font-heading);
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .motion-stepper-widget {
      padding: var(--space-4);
      margin: var(--space-6) 0;
    }
    .stepper-grid {
      grid-template-columns: 1fr;
    }
    .stepper-mantra-box {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
