---
// GlobalFloatingCTA.astro - Thanh liên hệ nổi đa kênh (Gọi, Zalo, Đăng ký) tối ưu CRO cho toàn trang
---

<div class="site-floating-cta" id="global-floating-cta" aria-label="Thanh liên hệ nhanh">
  <div class="floating-cta-inner">
    <!-- Nút Gọi Hotline -->
    <a href="/khoa-hoc-boi/doanh-nghiep/" class="cta-action cta-action-call" aria-label="Doanh nghiệp">🏢</a>

    <!-- Nút Nhắn Zalo -->
    <a href="/hoc-boi-o-dau/" class="cta-action cta-action-zalo" aria-label="Bể bơi gần bạn">📍</a>

    <!-- Nút Đăng Ký Học Thử -->
    <a href="/lien-he/" class="cta-action cta-action-register" id="floating-register-btn" aria-label="Đăng ký học thử miễn phí">
      <span class="register-badge-dot"></span>
      <span class="register-text">Đăng Ký Học Thử</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="cta-arrow">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  </div>
</div>

<style>
  .site-floating-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(0, 119, 182, 0.12);
    box-shadow: 0 -4px 24px rgba(2, 48, 71, 0.08);
    padding: 8px 12px;
    padding-bottom: max(8px, env(safe-area-inset-bottom));
    transform: translateY(110%);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-floating-cta.visible {
    transform: translateY(0);
  }

  .floating-cta-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: var(--font-heading, sans-serif);
    transition: all 200ms ease;
    border-radius: 12px;
  }

  .cta-action:active {
    transform: scale(0.96);
  }

  .cta-icon-wrapper {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
    transition: all 200ms ease;
  }

  /* Hotline */
  .cta-action-call {
    flex: 1;
    color: #0077B6;
    padding: 4px;
  }
  .cta-action-call .cta-icon-wrapper {
    background: rgba(0, 119, 182, 0.1);
    color: #0077B6;
  }

  /* Zalo */
  .cta-action-zalo {
    flex: 1;
    color: #0068FF;
    padding: 4px;
  }
  .cta-action-zalo .cta-icon-wrapper {
    background: rgba(0, 104, 255, 0.08);
  }

  .cta-label {
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  /* Register CTA */
  .cta-action-register {
    flex: 2.2;
    flex-direction: row;
    gap: 6px;
    background: linear-gradient(135deg, #FF6B35 0%, #FF8A5C 100%);
    color: #FFFFFF;
    padding: 10px 14px;
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(255, 107, 53, 0.35);
    font-weight: 700;
    font-size: 0.88rem;
    position: relative;
    overflow: hidden;
  }

  .cta-action-register:hover {
    box-shadow: 0 6px 18px rgba(255, 107, 53, 0.45);
    color: #FFFFFF;
  }

  .register-badge-dot {
    width: 7px;
    height: 7px;
    background-color: #FFFFFF;
    border-radius: 50%;
    animation: cta-pulse 1.8s infinite;
  }

  .cta-arrow {
    transition: transform 200ms ease;
  }
  .cta-action-register:hover .cta-arrow {
    transform: translateX(2px);
  }

  @keyframes cta-pulse {
    0% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.9); opacity: 0.8; }
  }

  /* Desktop docking: Hiển thị dạng floating badge góc dưới phải */
  @media (min-width: 769px) {
    .site-floating-cta {
      display: none; /* Trên desktop, Header CTA & Sidebar đã luôn hiển thị rõ ràng */
    }
  }
</style>

<script>
  // Tự động hiển thị khi cuộn qua 250px
  const floatingCta = document.getElementById('global-floating-cta');
  if (floatingCta) {
    // Nếu có form đăng ký trên trang, tự động link tới #dang-ky
    const regForm = document.getElementById('dang-ky') || document.querySelector('.cl-registration-form');
    const registerBtn = document.getElementById('floating-register-btn') as HTMLAnchorElement | null;
    if (regForm && registerBtn) {
      registerBtn.setAttribute('href', '#dang-ky');
      registerBtn.addEventListener('click', (e) => {
        e.preventDefault();
        regForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }

    const onScroll = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      if (scrollY > 250) {
        floatingCta.classList.add('visible');
      } else {
        floatingCta.classList.remove('visible');
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    // Run once on load
    onScroll();
  }
</script>
