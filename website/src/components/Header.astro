---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Giới thiệu', href: '/gioi-thieu/' },
  {
    label: 'Khóa học',
    href: '/khoa-hoc-boi/',
    children: [
      { label: 'Khóa 1 kèm 1', href: '/khoa-hoc-boi/ca-nhan/' },
      { label: 'Khóa học nhóm', href: '/khoa-hoc-boi/nhom/' },
      { label: 'Doanh nghiệp & Vinhomes', href: '/khoa-hoc-boi/doanh-nghiep/' },
      { label: 'Học bơi trẻ em', href: '/khoa-hoc-boi/tre-em/' },
      { label: 'Học bơi người lớn', href: '/khoa-hoc-boi/nguoi-lon/' },
      { label: 'Học bơi người cao tuổi', href: '/khoa-hoc-boi/nguoi-cao-tuoi/' },
      { label: 'Học bơi người sợ nước', href: '/khoa-hoc-boi/nguoi-so-nuoc/' },
    ],
  },
  {
    label: 'Kỹ thuật bơi',
    href: '/ky-thuat-boi/',
    children: [
      { label: 'Kỹ thuật bơi ếch', href: '/ky-thuat-boi/hoc-boi-ech/' },
      { label: 'Kỹ thuật bơi sải', href: '/ky-thuat-boi/hoc-boi-sai/' },
      { label: 'Kỹ thuật bơi ngửa', href: '/ky-thuat-boi/hoc-boi-ngua/' },
      { label: 'Kỹ thuật bơi bướm', href: '/ky-thuat-boi/hoc-boi-buom/' },
      { label: 'Kỹ năng đứng nước', href: '/ky-thuat-boi/ky-nang-dung-nuoc/' },
    ],
  },
  {
    label: 'Địa điểm',
    href: '/dia-diem/ha-noi/',
    children: [
      { label: 'Học bơi tại Hà Nội', href: '/dia-diem/ha-noi/' },
      { label: 'Học bơi tại TP.HCM', href: '/dia-diem/tphcm/' },
    ],
  },
  { label: 'Tin tức', href: '/tin-tuc/' },
  { label: 'Liên hệ', href: '/lien-he/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="logo" aria-label="Swim For Life Việt Nam - Trang chủ">
      <img
        src="/images/logo/swim-for-life-logo.png"
        alt="Logo Trung tâm dạy bơi Swim For Life Việt Nam"
        width="44"
        height="44"
        loading="eager"
      />
    </a>

    <!-- Navigation -->
    <nav class="nav-menu" id="nav-menu" aria-label="Menu chính">
      {navItems.map((item) =>
        item.children ? (
          <div class="nav-dropdown">
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
            >
              {item.label}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="margin-left:4px;">
                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="nav-dropdown-menu">
              {item.children.map((child) => (
                <a href={child.href} class="nav-dropdown-item">
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <!-- CTA & Phone -->
    <div class="header-cta">
      <a href="/khoa-hoc-boi/doanh-nghiep/" class="header-phone" aria-label="Khóa học doanh nghiệp">🏢 Hợp Tác Doanh Nghiệp</a>
      <a href="/lien-he/" class="btn btn-accent btn-sm pulse" id="header-cta-btn">
        Đăng Ký Học Thử
      </a>
    </div>

    <!-- Mobile Quick Call & Menu Toggle -->
    <div class="mobile-header-actions">
      <a href="/khoa-hoc-boi/doanh-nghiep/" class="header-phone" aria-label="Khóa học doanh nghiệp">🏢 Hợp Tác Doanh Nghiệp</a>

      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Mở menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .mobile-header-actions {
    display: none;
    align-items: center;
    gap: 10px;
  }

  .mobile-call-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: linear-gradient(135deg, #0077B6 0%, #00B4D8 100%);
    color: #FFFFFF !important;
    padding: 7px 14px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(0, 119, 182, 0.3);
    transition: transform 150ms ease;
  }

  .mobile-call-btn:active {
    transform: scale(0.96);
  }

  @media (max-width: 768px) {
    .mobile-header-actions {
      display: flex;
    }
  }
</style>
